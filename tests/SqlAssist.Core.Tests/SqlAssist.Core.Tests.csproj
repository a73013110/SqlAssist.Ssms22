<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>SqlAssist.Core.Tests</AssemblyName>
    <RootNamespace>SqlAssist.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xunit.v3 直接執行於 Microsoft.Testing.Platform，不需要 VSTest 轉接層。 -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SqlAssist.Core\SqlAssist.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Unified Settings 的註冊檔。設定相關的測試全部以它為基準反推程式碼
      （見 Settings 資料夾的 RegistrationManifest），所以測試輸出裡要有這份檔案。
    -->
    <None Include="..\..\src\SqlAssist.Ssms22\SqlAssist.registration.json" Link="SqlAssist.registration.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

{
  // 產生的指令碼裡的註解：檔頭與寫不出來的部分。用產生當下的語言；已經寫進查詢視窗的
  // 不回頭改。T-SQL 關鍵字、權限名稱與系統檢視名稱不翻。
  // 檔頭四行：值是伺服器與資料庫、ISO 時間、工具版本與指令碼風格名稱。
  "HeaderSource": "來源：{value}",
  "HeaderGeneratedAt": "產生時間：{value}",
  "HeaderTool": "工具：{value}",
  "HeaderStyle": "風格：{value}",
  "TriggerUnavailable": "取不到觸發程序 {trigger} 的定義：它是 WITH ENCRYPTION 建立的，或這個登入沒有它的 VIEW DEFINITION 權限。",
  "TriggerClr": "觸發程序 {trigger} 是 CLR 組件實作的，本來就沒有 T-SQL 定義可以寫出。",
  "ExtendedPropertySkipped": "未輸出擴充屬性 {property}：目標 {target} 未包含於本次指令碼，或其名稱已省略。",
  // 資料表型別的指令碼結尾；換行處各自成為一行註解。
  "TypeIndexesSkipped": "另有 {count} 個索引沒有寫進來：CREATE INDEX 與 ALTER TABLE 對型別都不合法，\n而 CREATE TYPE 的括號裡只放得下不具名的條件約束。",
  // 寫在 AS (/* … */) 裡，代替取不到的計算資料行運算式。
  "ExpressionUnavailable": "無法取得運算式",
  // 認不出種類的物件：{kind} 是物件種類的顯示名稱。
  "UnscriptableHeading": "無法為 {name}（{kind}）產生可以執行的指令碼。",
  "UnscriptableReason": "SqlAssist 認不得這個物件的種類，因此不知道它的定義該長什麼樣。",
  "UnscriptableAvailable": "以下是查得到的部分："
}

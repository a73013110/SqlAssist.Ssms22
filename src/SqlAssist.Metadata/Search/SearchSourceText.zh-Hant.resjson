{
  // SQL Search 的資料來源（資料庫物件、SQL Agent 作業）交給清單、頁尾與指令碼的文字。
  // ── 來源名稱與分類：種類下拉與失敗訊息用 ──
  "CatalogDisplayName": "資料庫物件",
  "AgentJobDisplayName": "SQL Agent 作業",
  "AgentJobCategory": "作業",
  "AgentJobStepCategory": "作業步驟",
  // ── 清單列 ──
  // 作業步驟那一列的標題；› 是階層分隔，照原樣保留。
  "AgentJobStepTitle": "{job} › 第 {order} 步",
  "AgentJobNamedStepTitle": "{job} › 第 {order} 步 {step}",
  // 伺服器說不出自己的名字時，膠囊上代替伺服器名稱的字。
  "UnknownServerName": "(不明伺服器)",
  // 搜尋範圍的資料庫清單裡，系統資料庫名稱後面的標記。
  "SystemDatabase": "{name}（系統）",
  // ── 完整度：這一輪沒搜到的來源 ──
  "DatabaseListUnavailable": "問不到這台伺服器的資料庫清單，這一輪沒有搜任何資料庫",
  // ── SQL Agent 作業步驟開成指令碼時的開頭註解 ──
  "AgentJobScriptJob": "SQL Agent 作業：{job}",
  "AgentJobScriptServer": "伺服器：{server}",
  "AgentJobScriptDisabled": "這個作業目前是停用的。",
  "AgentJobScriptStepsNote": "以下是步驟命令本身，不是排程或通知設定；改動這裡的文字不會回寫到作業上。",
  "AgentJobScriptStep": "第 {order} 步",
  "AgentJobScriptNamedStep": "第 {order} 步：{step}",
  // 接在步驟標題後面的兩段，可能都有、只有一段或都沒有。
  "AgentJobScriptStepSubsystem": "（{subsystem}）",
  "AgentJobScriptStepDatabase": "　資料庫：{database}",
  "AgentJobScriptEmptyStep": "這一步沒有命令內容。",
  "AgentJobScriptNotTsql": "這一步的子系統不是 TSQL，下面的命令原文不能直接執行，已整段保留為註解。"
}

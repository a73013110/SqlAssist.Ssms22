      "expansionMode": "tabStops",
      "positions": ["StatementStart", "BlockStart"],
      "code": "BEGIN TRY\n    $tryBody$\nEND TRY\nBEGIN CATCH\n    $catchBody$\n    THROW;\nEND CATCH$end$;",

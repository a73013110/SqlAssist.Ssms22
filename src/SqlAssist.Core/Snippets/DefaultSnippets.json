      "title": "IF EXISTS",
      "description": "資料存在時執行",
      "expansionMode": "tabStops",
      "positions": ["StatementStart", "BlockStart"],
      "code": "IF EXISTS\n(\n    SELECT 1\n    FROM [$schema$].[$table$]\n    WHERE $condition$\n)\nBEGIN\n    $body$\nEND$end$",

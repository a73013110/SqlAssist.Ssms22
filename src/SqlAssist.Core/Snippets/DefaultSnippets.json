        { "id": "tryBody", "default": "SELECT 1;", "tooltip": "主要處理內容" },
        { "id": "catchBody", "default": "SELECT ERROR_MESSAGE();", "tooltip": "錯誤處理內容" }
      ]
    },
    {
      "id": "builtin.cs",
      "category": "controlFlow",
      "shortcut": "cs",
      "title": "CASE WHEN",
      "description": "CASE 條件運算式",
      "expansionMode": "tabStops",
      "positions": ["SelectList", "Predicate"],
      "code": "CASE\n    WHEN $condition$ THEN $result$\n    ELSE $fallback$\nEND$end$",
      "placeholders": [
        { "id": "condition", "default": "1 = 1", "tooltip": "判斷條件" },
        { "id": "result", "default": "1", "tooltip": "成立時結果" },
        { "id": "fallback", "default": "0", "tooltip": "其他情況結果" }
      ]
    },
    {
      "id": "builtin.cur",
      "category": "controlFlow",
      "shortcut": "cur",
      "title": "CURSOR",
      "description": "完整的本機快速順向 CURSOR 樣板",
      "expansionMode": "tabStops",
      "positions": ["StatementStart", "BlockStart"],
      "code": "DECLARE $cursor$ CURSOR LOCAL FAST_FORWARD FOR\nSELECT [$column$]\nFROM [$schema$].[$table$];\n\nOPEN $cursor$;\nFETCH NEXT FROM $cursor$ INTO @$variable$;\n\nWHILE @@FETCH_STATUS = 0\nBEGIN\n    $body$\n    FETCH NEXT FROM $cursor$ INTO @$variable$;\nEND;\n\nCLOSE $cursor$;\nDEALLOCATE $cursor$$end$;",
      "placeholders": [
        { "id": "cursor", "default": "item_cursor", "tooltip": "游標名稱；相同名稱會同步" },
        { "id": "column", "default": "ColumnName", "tooltip": "讀取欄位" },
        { "id": "schema", "default": "dbo", "tooltip": "結構描述" },
        { "id": "table", "default": "TableName", "tooltip": "資料表名稱" },
        { "id": "variable", "default": "Value", "tooltip": "接收資料的變數；請先宣告" },
        { "id": "body", "default": "SELECT @Value;", "tooltip": "逐筆處理內容" }
      ]
    },
    {
      "id": "builtin.trn",
      "category": "controlFlow",
      "shortcut": "trn",
      "title": "安全交易樣板",
      "description": "含 XACT_ABORT、TRY／CATCH 與回復的交易",
      "expansionMode": "tabStops",
      "positions": ["StatementStart", "BlockStart"],
      "code": "SET XACT_ABORT ON;\n\nBEGIN TRY\n    BEGIN TRANSACTION;\n\n    $body$\n\n    COMMIT TRANSACTION;\nEND TRY\nBEGIN CATCH\n    IF @@TRANCOUNT > 0\n        ROLLBACK TRANSACTION;\n\n    THROW;\nEND CATCH$end$;",
      "placeholders": [
        { "id": "body", "default": "SELECT 1;", "tooltip": "交易內容" }
      ]
    },


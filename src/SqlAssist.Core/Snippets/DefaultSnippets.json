        { "id": "sourceTable", "default": "SourceTable", "tooltip": "來源資料表" }
      ]
    },
    {
      "id": "builtin.ui",
      "category": "dml",
      "shortcut": "ui",
      "title": "UPDATE（安全條件）",
      "description": "以預設不成立的條件更新資料",
      "isDestructive": true,
      "expansionMode": "tabStops",
      "positions": ["StatementStart"],
      "code": "UPDATE [$schema$].[$table$]\nSET [$column$] = $value$\nWHERE 1 = 0\n  AND $condition$$end$;",
      "placeholders": [
        { "id": "schema", "default": "dbo", "tooltip": "結構描述" },
        { "id": "table", "default": "TableName", "tooltip": "資料表名稱" },
        { "id": "column", "default": "ColumnName", "tooltip": "要更新的欄位" },
        { "id": "value", "default": "NULL", "tooltip": "新值" },
        { "id": "condition", "default": "1 = 1", "tooltip": "更新條件；確認後移除 1 = 0" }
      ]
    },
    {
      "id": "builtin.df",
      "category": "dml",
      "shortcut": "df",
      "title": "DELETE FROM（安全條件）",
      "description": "以預設不成立的條件刪除資料",
      "isDestructive": true,
      "expansionMode": "tabStops",
      "positions": ["StatementStart"],
      "code": "DELETE FROM [$schema$].[$table$]\nWHERE 1 = 0\n  AND $condition$$end$;",
      "placeholders": [
        { "id": "schema", "default": "dbo", "tooltip": "結構描述" },
        { "id": "table", "default": "TableName", "tooltip": "資料表名稱" },
        { "id": "condition", "default": "1 = 1", "tooltip": "刪除條件；確認後移除 1 = 0" }
      ]
    },
    {
      "id": "builtin.mg",
      "category": "dml",
      "shortcut": "mg",
      "title": "MERGE",
      "description": "MERGE 樣板；執行前務必檢查並行與條件",
      "isDestructive": true,
      "expansionMode": "tabStops",
      "positions": ["StatementStart"],
      "code": "MERGE INTO [$targetSchema$].[$targetTable$] AS target\nUSING [$sourceSchema$].[$sourceTable$] AS source\n    ON target.[$keyColumn$] = source.[$keyColumn$]\nWHEN MATCHED AND 1 = 0 THEN\n    UPDATE SET target.[$updateColumn$] = source.[$updateColumn$]\nWHEN NOT MATCHED BY TARGET AND 1 = 0 THEN\n    INSERT ([$insertColumn$])\n    VALUES (source.[$insertColumn$])$end$;",
      "placeholders": [
        { "id": "targetSchema", "default": "dbo", "tooltip": "目標結構描述" },
        { "id": "targetTable", "default": "TargetTable", "tooltip": "目標資料表" },
        { "id": "sourceSchema", "default": "dbo", "tooltip": "來源結構描述" },
        { "id": "sourceTable", "default": "SourceTable", "tooltip": "來源資料表" },
        { "id": "keyColumn", "default": "KeyColumn", "tooltip": "比對鍵；相同名稱會同步" },
        { "id": "updateColumn", "default": "UpdateColumn", "tooltip": "更新欄位；相同名稱會同步" },
        { "id": "insertColumn", "default": "InsertColumn", "tooltip": "新增欄位；相同名稱會同步" }
      ]
    },


      "expansionMode": "tabStops",
      "positions": ["StatementStart", "BlockStart"],
      "code": "IF NOT EXISTS\n(\n    SELECT 1\n    FROM $table$\n    WHERE $condition$\n)\nBEGIN\n    $body$\nEND$end$",
      "placeholders": [
        { "id": "table", "default": "dbo.TableName", "tooltip": "資料表名稱；可含結構描述" },
        { "id": "condition", "default": "1 = 1", "tooltip": "判斷條件" },

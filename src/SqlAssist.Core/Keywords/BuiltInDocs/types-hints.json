      "summary": "",
      "examples": [
        {
          "id": "basic",
          "title": "基本用法",
          "sql": "DECLARE @at datetime2(3)   -- 括號裡是小數秒位數，預設 7"
        }
      ],
      "docsUrl": "https://learn.microsoft.com/sql/t-sql/data-types/datetime2-transact-sql"

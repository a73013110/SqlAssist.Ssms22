      "name": "JSON",
      "kind": "dataType",
      "summary": "",
      "examples": [
        {
          "id": "basic",
          "title": "基本用法",
          "sql": "DECLARE @doc json = '{\"copyNo\": 1}'   -- 只收物件或陣列，純量與空字串都會失敗"
        }
      ],

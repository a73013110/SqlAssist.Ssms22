{
  "Error": "Error code of last statement",
  "Identity": "Last generated identity value for this connection",
  "Rowcount": "Number of rows affected by last statement",
  "Trancount": "Number of active transactions in current connection",
  "CursorRows": "Number of rows in last opened cursor",
  "FetchStatus": "Status of last FETCH",
  "Procid": "Object ID of current module",
  "Datefirst": "Current value of SET DATEFIRST (first day of week)",
  "Dbts": "Last generated timestamp value in current database",
  "Langid": "ID of current language",
  "Language": "Name of current language",
  "LockTimeout": "Lock timeout in milliseconds for this session",
  "MaxConnections": "Maximum number of simultaneous connections allowed",
  "MaxPrecision": "Maximum precision for decimal and numeric",
  "Nestlevel": "Nesting level of current module",
  "Options": "Bit mask of current SET options",
  "Servername": "Name of this server",
  "Servicename": "Service name of this instance",
  "Spid": "ID of current session",
  "Textsize": "Current value of SET TEXTSIZE",
  "Version": "SQL Server version, date, and operating system",
  "Connections": "Number of login attempts since startup",
  "CpuBusy": "CPU busy time since startup",
  "Idle": "Idle time since startup",
  "IoBusy": "Time spent on I/O since startup",
  "PacketErrors": "Number of packet errors since startup",
  "PackReceived": "Number of packets read from network since startup",
  "PackSent": "Number of packets written to network since startup",
  "Timeticks": "Microseconds per time tick",
  "TotalErrors": "Number of disk I/O errors since startup",
  "TotalRead": "Number of disk reads since startup",
  "TotalWrite": "Number of disk writes since startup"
}

{
  // 通知標題：動詞開頭的現在進行式短語，不含物件名稱、狀態與標點。
  // 每個標題都有一個同名加 Done 的鍵，是成功後那一列的過去式；兩者要是同一件事的兩種時態。
  // 英文標題照 SSMS 狀態列的寫法用 -ing 開頭（Loading object list），Done 用過去式（Loaded object list）。
  // ── 中繼資料 ──
  "LoadingObjects": "載入物件清單",
  "LoadingObjectsDone": "已載入物件清單",
  "LoadingColumns": "載入欄位與定義",
  "LoadingColumnsDone": "已載入欄位與定義",
  "LoadingIndexes": "載入索引與條件約束",
  "LoadingIndexesDone": "已載入索引與條件約束",
  "LoadingSystemObjects": "載入系統物件",
  "LoadingSystemObjectsDone": "已載入系統物件",
  "LoadingCollations": "載入定序名單",
  "LoadingCollationsDone": "已載入定序名單",
  "LoadingDatabaseCollation": "載入資料庫定序",
  "LoadingDatabaseCollationDone": "已載入資料庫定序",
  "LoadingDatabases": "載入資料庫清單",
  "LoadingDatabasesDone": "已載入資料庫清單",
  "LoadingLinkedServers": "載入連結伺服器",
  "LoadingLinkedServersDone": "已載入連結伺服器",
  // 跨到同一台伺服器的另一個資料庫；主體是目標資料庫。
  "ConnectingToDatabase": "連線到其他資料庫",
  "ConnectingToDatabaseDone": "已連線到其他資料庫",
  // 四段式名稱的遠端跳躍。
  "QueryingLinkedServer": "透過連結伺服器查詢",
  "QueryingLinkedServerDone": "已透過連結伺服器查詢",
  // 只進診斷統計，永不上畫面。
  "CacheHit": "命中快取",
  "CacheHitDone": "已命中快取",
  // ── 建議清單 ──
  "PreparingSuggestions": "準備建議清單",
  "PreparingSuggestionsDone": "已準備建議清單",
  "SortingSuggestions": "排序建議清單",
  "SortingSuggestionsDone": "已排序建議清單",
  "FilteringSuggestions": "篩選建議清單",
  "FilteringSuggestionsDone": "已篩選建議清單",

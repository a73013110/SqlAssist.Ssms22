{
  // SQL 物件與建議項目的種類名稱：圖示朗讀、篩選鈕、建議清單右側說明、滑鼠停留提示、預覽分頁與欄名、
  // SQL Search 分類、通知主體共用同一句。
  // 同一種類在各處的譯名要一致，所以不在各功能各翻一次；只在某處才有的說法（例如篩選鈕的補充說明）
  // 留在那個功能的文字檔。複數形給列出一整類的地方（篩選鈕、分頁），中文與單數同字。
  "Unknown": "未知物件",
  "Keyword": "關鍵字",
  "Keywords": "關鍵字",
  // 內建說明的語句種類（EXEC、THROW、MERGE…）；圖示與關鍵字共用，這裡只補一行種類文字。
  "Statement": "陳述式",
  "Snippet": "程式碼片段",
  "Snippets": "程式碼片段",
  "Server": "伺服器",
  "LinkedServer": "連結伺服器",
  "Database": "資料庫",
  "Schema": "結構描述",
  "Table": "資料表",
  "Tables": "資料表",
  "TableType": "使用者自訂資料表型別",
  "View": "檢視",
  "Views": "檢視",
  "Procedure": "預存程序",
  "Procedures": "預存程序",
  // 內建說明的系統預存程序（sp_executesql、sp_help…），與使用者自訂的預存程序分開講。
  "SystemProcedure": "系統預存程序",
  "Function": "函式",
  "ScalarFunction": "純量函式",
  "ScalarFunctions": "純量函式",
  "BuiltInFunction": "內建函式",
  "BuiltInFunctions": "內建函式",
  "TableFunction": "資料表值函式",
  "InlineTableFunction": "內嵌資料表值函式",
  "Trigger": "觸發程序",
  "Triggers": "觸發程序",
  "Synonym": "同義字",
  "TemporaryTable": "暫存資料表",
  "TemporaryProcedure": "暫存預存程序",
  "TableVariable": "資料表變數",
  // WITH 宣告的一般資料表運算式；全名太長，建議清單右側放不下，兩種語言都寫縮寫。
  "CommonTableExpression": "CTE",
  "Sequence": "序列",
  "Sequences": "序列",
  "Column": "欄位",
  "Columns": "欄位",
  "Constraint": "條件約束",
  "Constraints": "條件約束",
  "Parameter": "參數",
  "Parameters": "參數",
  "DataType": "資料型別",
  // 建議清單在 FROM／JOIN 之後找的那一類：資料表、檢視、指令碼宣告的暫存表都算。
  "DataSource": "資料來源",
  // 指令碼自己宣告的暫存資料表、資料表變數與 CTE。
  "ScriptDataSource": "指令碼資料來源",
  // 敘述裡資料來源的別名（FROM dbo.Loan l 的 l）。
  "Alias": "別名",
  // DECLARE c CURSOR 宣告的具名資料指標；與內建語句說明同一個譯名，「游標」留給編輯器的插入點。
  "Cursor": "資料指標",
  // 查詢的 WINDOW 子句取的名稱（WINDOW w AS (…) 的 w）。
  "Window": "具名視窗",
  "Variable": "變數",
  "LocalVariable": "區域變數",
  "GlobalVariable": "全域變數",
  // 只有目錄檢視列得出名稱的那幾種（ALTER LOGIN、DROP USER、GRANT … TO 之後）；CatalogEntity 是它們合起來的總稱。
  "CatalogEntity": "目錄物件",
  "Login": "登入",
  "User": "使用者",
  "Role": "資料庫角色",
  "ServerRole": "伺服器角色",
  "ApplicationRole": "應用程式角色",
  "Credential": "認證",
  "DatabaseScopedCredential": "資料庫範圍認證",
  "Endpoint": "端點",
  "EventSession": "擴充事件工作階段",
  "ServerAudit": "伺服器稽核",
  "ServerAuditSpecification": "伺服器稽核規格",
  "DatabaseAuditSpecification": "資料庫稽核規格",
  "Certificate": "憑證",
  "AsymmetricKey": "非對稱金鑰",
  "SymmetricKey": "對稱金鑰",
  "PartitionFunction": "資料分割函式",
  "PartitionScheme": "資料分割配置",
  "FulltextCatalog": "全文檢索目錄",
  "Assembly": "組件",
  "ExternalDataSource": "外部資料來源",
  "ExternalFileFormat": "外部檔案格式",
  // Service Broker 的物件；譯名照物件總管。
  "Queue": "佇列",
  "Service": "服務",
  "Contract": "合約",
  "MessageType": "訊息類型",
  "Route": "路由",
  "RemoteServiceBinding": "遠端服務繫結",
  "BrokerPriority": "Broker 優先權",
  "Collation": "定序",
  // SET LANGUAGE、DEFAULT_LANGUAGE = 之後的語言名稱（sys.syslanguages）。
  "Language": "語言",
  // AT TIME ZONE 之後的時區名稱（sys.time_zone_info）。
  "TimeZone": "時區",
  // DATEADD、DATEDIFF 等函式的第一個引數（year、month…）。
  "DatePart": "日期部分",
  "TableHint": "資料表提示",
  "QueryHint": "查詢提示",
  // 種類加名稱的標題：「資料表 dbo.Loan」、「結構描述 dbo」。
  "Named": "{kind} {name}"
}

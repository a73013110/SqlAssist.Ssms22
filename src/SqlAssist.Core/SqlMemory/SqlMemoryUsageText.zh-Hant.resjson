  "DatabaseFile": "資料庫檔案 {size}",
  "WalFile": "（另有 WAL {size}）",
  "Reclaimable": "可回收約 {size}",
  // {used} 是目前數量，後面接「沒有上限」。
  "Unlimited": "{used}（不限）",

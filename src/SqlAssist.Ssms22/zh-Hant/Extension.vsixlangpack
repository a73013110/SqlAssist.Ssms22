<?xml version="1.0" encoding="utf-8"?>
<!--
  繁中 SSMS 在擴充功能管理員與安裝程式上顯示的名稱與說明；其他介面語言看 vsixmanifest 本身（英文）。
  資料夾名稱是比對的文化名稱，用中性文化 zh-Hant 讓 zh-TW、zh-HK 都對得到，與 SSMS 內建擴充的慣例相同。
  跟 SqlAssist 的語言設定無關：這裡由 SSMS 的介面語言決定。
-->
<VsixLanguagePack Version="1.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema-lp/2010">
  <LocalizedName>SqlAssist for SSMS 22</LocalizedName>
  <LocalizedDescription xml:space="preserve">SSMS 22 的 T-SQL 即時建議、程式碼片段與資料庫物件結構預覽工具。設定整合於 SSMS 的 Unified Settings。</LocalizedDescription>
</VsixLanguagePack>

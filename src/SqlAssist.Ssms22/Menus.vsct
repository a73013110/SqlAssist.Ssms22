<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidSqlAssistPackage">
    <Groups>
      <!-- 只放「編輯到一半會想按」的東西；設定一次就不再碰的偏好只留在設定頁。 -->
      <Group guid="guidSqlAssistCommandSet" id="SqlAssistToggleGroup" priority="0x0100">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistMenu" />
      </Group>
      <Group guid="guidSqlAssistCommandSet" id="SqlAssistActionsGroup" priority="0x0200">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistMenu" />
      </Group>
      <Group guid="guidSqlAssistCommandSet" id="SqlAssistSupportGroup" priority="0x0300">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistMenu" />
      </Group>

      <!--
        設定頁上的按鈕命令。Unified Settings 以 (命令集, ID) 定址，命令必須存在於
        命令表，但不該出現在任何選單裡——所以掛在一個沒有父選單的群組下，
        再各自標上 CommandWellOnly。
      -->
      <Group guid="guidSqlAssistCommandSet" id="SqlAssistSettingsPageGroup" priority="0x0900" />

      <!--
        掛進 SSMS 查詢結果格線的右鍵選單。父選單是 SSMS 內部的命令表項目，不是
        公開的擴充契約，值的出處是 SQLEditors.dll：DisplaySqlResultsTabControl
        的 WndProc 收到 WM_CONTEXTMENU、確認作用中控制項是 GridControl 之後，
        呼叫 CommonUtils.DisplayPopupMenu(shell, 112, x, y, selectedTab)，而那個
        多載補上的群組就是 SQLWorkbenchCommands.GUID_SQLEditorGroup。
        全組件只有那一處用 112，其他窗格各自不同（訊息 96、執行計畫 128），
        所以這個 ID 沒有歧義。

        SSMS 改版換掉其中任何一個值的症狀，是這一段選單安靜地不出現——沒有例外、
        沒有紀錄，跟命令掛錯層是同一類。兩個常數都在公開類別 SQLWorkbenchCommands
        裡，所以 tools\Test-CommandTable.ps1 有辦法在建置期比對，不必等使用者發現。
      -->
      <Group guid="guidSqlAssistCommandSet" id="SqlAssistResultGridGroup" priority="0x0800">
        <Parent guid="guidSqlWorkbenchEditorGroup" id="IDM_SQLWB_SQLRESGRID_CONTEXT" />
      </Group>

      <!-- 子選單裡的命令。掛在子選單自己底下，不是上面那個掛進 SSMS 的群組。 -->
      <Group guid="guidSqlAssistCommandSet" id="SqlAssistResultGridActionsGroup" priority="0x0100">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistResultGridMenu" />
      </Group>
      <Group guid="guidSqlAssistCommandSet" id="SqlAssistResultGridDiagnosticsGroup" priority="0x0900">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistResultGridMenu" />
      </Group>
    </Groups>

    <Menus>
      <!--
        VSCT 的階層是 Menu → Group → Menu／Button，中間不能跳層。
        子選單的 Parent 必須是一個 Group（IDG_*），不能是 Menu（IDM_*）。
        原本掛在 IDM_VS_MENU_TOOLS 底下不會有任何編譯或執行期錯誤，
        pkgdef 與命令處理器也都正常註冊，但「工具 → SqlAssist」整個不會出現。
        IDG_VS_TOOLS_OTHER2 是 Tools 選單內既有的一般用途群組。
      -->
      <Menu guid="guidSqlAssistCommandSet" id="SqlAssistMenu" priority="0x0700" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_TOOLS_OTHER2" />
        <CommandFlag>AlwaysCreate</CommandFlag>
        <Strings>
          <ButtonText>SqlAssist</ButtonText>
          <CommandName>SqlAssist</CommandName>
        </Strings>
      </Menu>

      <!--
        結果格線的右鍵選單是 SSMS 自己的，上面已經有十幾項。收成一層子選單，
        本擴充的命令再多也只佔一列，而且看得出是誰加的。
      -->
      <Menu guid="guidSqlAssistCommandSet" id="SqlAssistResultGridMenu" priority="0x0100" type="Menu">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistResultGridGroup" />
        <CommandFlag>AlwaysCreate</CommandFlag>
        <Strings>
          <ButtonText>SqlAssist</ButtonText>
          <CommandName>SqlAssist</CommandName>
        </Strings>
      </Menu>
    </Menus>

    <Buttons>
      <Button guid="guidSqlAssistCommandSet" id="cmdidToggleEnabled" priority="0x0100" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistToggleGroup" />
        <CommandFlag>TextChanges</CommandFlag>
        <Strings><ButtonText>啟用 SqlAssist</ButtonText></Strings>
      </Button>
      <Button guid="guidSqlAssistCommandSet" id="cmdidToggleSuggestions" priority="0x0200" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistToggleGroup" />
        <Strings><ButtonText>顯示即時建議</ButtonText></Strings>
      </Button>

      <Button guid="guidSqlAssistCommandSet" id="cmdidGoToDefinition" priority="0x0100" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistActionsGroup" />
        <Strings><ButtonText>移至定義</ButtonText></Strings>
      </Button>
      <Button guid="guidSqlAssistCommandSet" id="cmdidShowObjectStructure" priority="0x0150" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistActionsGroup" />
        <Strings><ButtonText>顯示游標處物件的結構</ButtonText></Strings>
      </Button>
      <Button guid="guidSqlAssistCommandSet" id="cmdidRefreshSuggestions" priority="0x0200" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistActionsGroup" />
        <Strings><ButtonText>重新整理建議</ButtonText></Strings>
      </Button>
      <Button guid="guidSqlAssistCommandSet" id="cmdidManageSnippets" priority="0x0300" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistActionsGroup" />
        <Strings><ButtonText>程式碼片段…</ButtonText></Strings>
      </Button>

      <Button guid="guidSqlAssistCommandSet" id="cmdidOpenSettings" priority="0x0100" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistSupportGroup" />
        <Strings><ButtonText>設定…</ButtonText></Strings>
      </Button>
      <Button guid="guidSqlAssistCommandSet" id="cmdidShowDiagnostics" priority="0x0200" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistSupportGroup" />
        <Strings><ButtonText>關於與診斷…</ButtonText></Strings>
      </Button>

      <Button guid="guidSqlAssistCommandSet" id="cmdidOpenDiagnosticsLog" priority="0x0200" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistSettingsPageGroup" />
        <CommandFlag>CommandWellOnly</CommandFlag>
        <Strings><ButtonText>開啟 SqlAssist 診斷紀錄檔</ButtonText></Strings>
      </Button>

      <Button guid="guidSqlAssistCommandSet" id="cmdidResultGridTempTable" priority="0x0100" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistResultGridActionsGroup" />
        <Strings><ButtonText>建立 #temp 指令碼（新查詢視窗）</ButtonText></Strings>
      </Button>
      <Button guid="guidSqlAssistCommandSet" id="cmdidResultGridInPredicate" priority="0x0200" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistResultGridActionsGroup" />
        <Strings><ButtonText>複製成 IN 條件</ButtonText></Strings>
      </Button>

      <!--
        格線內部的探測。留著而不是刪掉：SSMS 換版之後這一組功能安靜地失效時，
        它是唯一問得出「格線還在不在、方法還叫不叫這個名字」的東西。
        只在「詳細記錄」打開時才出現，平常不佔使用者的選單。
      -->
      <Button guid="guidSqlAssistCommandSet" id="cmdidProbeResultGrid" priority="0x0100" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistResultGridDiagnosticsGroup" />
        <Strings><ButtonText>探測這個結果格線（診斷）</ButtonText></Strings>
      </Button>
    </Buttons>
  </Commands>

  <KeyBindings>
    <KeyBinding guid="guidSqlAssistCommandSet"
                id="cmdidToggleEnabled"
                editor="guidVSStd97"
                key1="S"
                mod1="Control Alt Shift" />
    <!--
      與 F12 使用同一條命令表路徑。SSMS 查詢視窗沒有一個可依賴的編輯器範圍，
      所以仍綁在全域範圍；命令處理器在 SqlAssist 停用或沒有 SQL 編輯器時回報停用，
      避免 Ctrl+Shift+D 在其他表面攔走殼層原本的行為。
    -->
    <KeyBinding guid="guidSqlAssistCommandSet"
                id="cmdidRefreshSuggestions"
                editor="guidVSStd97"
                key1="D"
                mod1="Control Shift" />
    <!--
      F12。實測 SSMS 22 沒有把 F12 綁在 Edit.GoToDefinition 上——濾鏡掛好了也從來
      收不到 VSStd97/GotoDefn，紀錄檔顯示命令是從這一條鍵繫結進來的。因此這裡不是
      備援，是唯一真正生效的路；拿掉它 F12 就完全沒有反應。

      全域範圍（guidVSStd97）而不是某個編輯器範圍：SSMS 的查詢視窗用的是它自己的
      編輯器工廠，猜錯 GUID 的症狀是繫結安靜地不生效。全域一定註冊得上，代價是
      在非 SQL 編輯器裡也綁到，因此命令自己要在沒有 SQL 編輯器時回報停用——
      停用的命令不會被派送，那些地方的 F12 就照常落回殼層。

      使用者若在「選項 → 鍵盤」把 Edit.GoToDefinition 綁到別的鍵，那一條由
      SqlShellCommandFilter 接，與這裡互斥（鍵繫結只會解析出一個命令）。
    -->
    <KeyBinding guid="guidSqlAssistCommandSet"
                id="cmdidGoToDefinition"
                editor="guidVSStd97"
                key1="VK_F12" />
    <!--
      Alt+F12 在 SSMS 22 實機上不會抵達命令表或命令濾鏡；改用 Ctrl+F12，並沿用
      F12 的全域範圍。命令狀態守門可避免在沒有 SQL 編輯器時攔走按鍵。
    -->
    <KeyBinding guid="guidSqlAssistCommandSet"
                id="cmdidShowObjectStructure"
                editor="guidVSStd97"
                key1="VK_F12"
                mod1="Control" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidSqlAssistPackage" value="{b386e18d-f34b-4db4-a40d-b9092a31d89f}" />
    <GuidSymbol name="guidSqlAssistCommandSet" value="{4a188946-9364-4f07-af7e-97f3bd7ca7a7}">
      <IDSymbol name="SqlAssistMenu" value="0x1000" />
      <IDSymbol name="SqlAssistToggleGroup" value="0x1100" />
      <IDSymbol name="SqlAssistActionsGroup" value="0x1300" />
      <IDSymbol name="SqlAssistSupportGroup" value="0x1400" />
      <IDSymbol name="SqlAssistSettingsPageGroup" value="0x1500" />
      <IDSymbol name="SqlAssistResultGridGroup" value="0x1600" />
      <IDSymbol name="SqlAssistResultGridMenu" value="0x1610" />
      <IDSymbol name="SqlAssistResultGridActionsGroup" value="0x1620" />
      <IDSymbol name="SqlAssistResultGridDiagnosticsGroup" value="0x1630" />
      <!-- 空號 0x0101–0x0104、0x0203–0x0205、0x0207 是已移除的命令，不回收。 -->
      <IDSymbol name="cmdidToggleEnabled" value="0x0100" />
      <IDSymbol name="cmdidToggleSuggestions" value="0x0105" />
      <IDSymbol name="cmdidShowDiagnostics" value="0x0200" />
      <IDSymbol name="cmdidOpenSettings" value="0x0201" />
      <IDSymbol name="cmdidRefreshSuggestions" value="0x0202" />
      <IDSymbol name="cmdidShowObjectStructure" value="0x0206" />
      <IDSymbol name="cmdidOpenDiagnosticsLog" value="0x0208" />
      <IDSymbol name="cmdidManageSnippets" value="0x0209" />
      <IDSymbol name="cmdidGoToDefinition" value="0x020A" />
      <IDSymbol name="cmdidProbeResultGrid" value="0x0300" />
      <IDSymbol name="cmdidResultGridTempTable" value="0x0301" />
      <IDSymbol name="cmdidResultGridInPredicate" value="0x0302" />
    </GuidSymbol>

    <!--
      SSMS 自己的選單群組，值取自 SQLEditors.dll 的公開類別 SQLWorkbenchCommands
      （GUID_SQLEditorGroup 與 IDM_SQLWB_SQLRESGRID_CONTEXT = 112）。
      這裡只宣告我們要掛進去的那一個選單，不複製整份清單。
    -->
    <GuidSymbol name="guidSqlWorkbenchEditorGroup" value="{33F13AC3-80BB-4ECB-85BC-225435603A5E}">
      <IDSymbol name="IDM_SQLWB_SQLRESGRID_CONTEXT" value="0x0070" />
    </GuidSymbol>
  </Symbols>
</CommandTable>

<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidSqlAssistPackage">
    <Groups>
      <!-- 只放「編輯到一半會想按」的東西；設定一次就不再碰的偏好只留在設定頁。 -->
      <Group guid="guidSqlAssistCommandSet" id="SqlAssistToggleGroup" priority="0x0100">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistMenu" />
      </Group>
      <Group guid="guidSqlAssistCommandSet" id="SqlAssistActionsGroup" priority="0x0200">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistMenu" />
      </Group>
      <Group guid="guidSqlAssistCommandSet" id="SqlAssistSupportGroup" priority="0x0300">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistMenu" />
      </Group>

      <!--
        設定頁上的按鈕命令。Unified Settings 以 (命令集, ID) 定址，命令必須存在於
        命令表，但不該出現在任何選單裡——所以掛在一個沒有父選單的群組下，
        再各自標上 CommandWellOnly。
      -->
      <Group guid="guidSqlAssistCommandSet" id="SqlAssistSettingsPageGroup" priority="0x0900" />

      <!--
        掛進 SSMS 查詢結果格線的右鍵選單。父選單是 SSMS 內部的命令表項目，不是
        公開的擴充契約，值的出處是 SQLEditors.dll：DisplaySqlResultsTabControl
        的 WndProc 收到 WM_CONTEXTMENU、確認作用中控制項是 GridControl 之後，
        呼叫 CommonUtils.DisplayPopupMenu(shell, 112, x, y, selectedTab)，而那個
        多載補上的群組就是 SQLWorkbenchCommands.GUID_SQLEditorGroup。
        全組件只有那一處用 112，其他窗格各自不同（訊息 96、執行計畫 128），
        所以這個 ID 沒有歧義。

        SSMS 改版換掉其中任何一個值的症狀，是這一段選單安靜地不出現——沒有例外、
        沒有紀錄，跟命令掛錯層是同一類。兩個常數都在公開類別 SQLWorkbenchCommands
        裡，所以 tools\Test-CommandTable.ps1 有辦法在建置期比對，不必等使用者發現。

        命令直接掛在這裡，不收成子選單：它們的用法是「選幾格、按右鍵、挑一個」，
        多一層子選單就是每一次都多一次移動與等待展開。

        群組是殼層畫分隔線的單位，所以分成三組就是三段。分法照的是「按下去之後
        東西跑到哪裡」，不是功能相不相像：第一組進剪貼簿，接下來要按的是 Ctrl+V；
        第二組開一個新的視窗，畫面會換掉。混在一起的話，使用者要一項一項讀完
        才知道哪一個會把手上的畫面換掉。
      -->
      <Group guid="guidSqlAssistCommandSet" id="SqlAssistResultGridCopyGroup" priority="0x0800">
        <Parent guid="guidSqlWorkbenchEditorGroup" id="IDM_SQLWB_SQLRESGRID_CONTEXT" />
      </Group>

      <Group guid="guidSqlAssistCommandSet" id="SqlAssistResultGridActionsGroup" priority="0x0810">
        <Parent guid="guidSqlWorkbenchEditorGroup" id="IDM_SQLWB_SQLRESGRID_CONTEXT" />
      </Group>

      <!--
        掛進 SQL 查詢視窗「文字區」的右鍵選單，自成一段。父選單同樣是 SSMS 的內部
        值：ScriptEditorControl 收到右鍵時呼叫
        CommonUtils.DisplayPopupMenu(shell, ScriptEditorContextMenuID, x, y, this,
        ScriptEditorContextMenuGroup)，而 SqlScriptEditorControl 在一般查詢視窗回的是
        80（IDM_SQLWB_SQLSCRIPT_CONTEXT）＋基底的 GUID_SQLEditorGroup——與結果格線
        同一個群組 GUID，只有選單 ID 不同。

        除錯中或開的是 SQL 物件文件時，它改回 VS 的 IDM_VS_CTXT_CODEWIN（1037），
        這一段就不會出現。那不是失敗，是 SSMS 換了另一份選單。

        自己一組而不是併進 SSMS 既有的段落：包夾的用法是「選一段、按右鍵、挑一個」，
        與旁邊的執行、連線、結果去向不是同一件事，殼層在群組之間畫的那條分隔線
        正是使用者一眼找到它的依據。
      -->
      <Group guid="guidSqlAssistCommandSet" id="SqlAssistEditorContextGroup" priority="0x0500">
        <Parent guid="guidSqlWorkbenchEditorGroup" id="IDM_SQLWB_SQLSCRIPT_CONTEXT" />
      </Group>

      <!-- 診斷第三組。它只在「詳細記錄」打開時出現，那時候才會多一條分隔線。 -->
      <Group guid="guidSqlAssistCommandSet" id="SqlAssistResultGridDiagnosticsGroup" priority="0x0820">
        <Parent guid="guidSqlWorkbenchEditorGroup" id="IDM_SQLWB_SQLRESGRID_CONTEXT" />
      </Group>
    </Groups>

    <Menus>
      <!--
        VSCT 的階層是 Menu → Group → Menu／Button，中間不能跳層。
        子選單的 Parent 必須是一個 Group（IDG_*），不能是 Menu（IDM_*）。
        原本掛在 IDM_VS_MENU_TOOLS 底下不會有任何編譯或執行期錯誤，
        pkgdef 與命令處理器也都正常註冊，但「工具 → SqlAssist」整個不會出現。
        IDG_VS_TOOLS_OTHER2 是 Tools 選單內既有的一般用途群組。
      -->
      <Menu guid="guidSqlAssistCommandSet" id="SqlAssistMenu" priority="0x0700" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_TOOLS_OTHER2" />
        <CommandFlag>AlwaysCreate</CommandFlag>
        <Strings>
          <ButtonText>SqlAssist</ButtonText>
          <CommandName>SqlAssist</CommandName>
        </Strings>
      </Menu>
    </Menus>

    <!--
      每顆按鈕都要有 CanonicalName 與 LocCanonicalName。沒有的話「選項 → 環境 →
      鍵盤」只會照選單路徑推出名字（例如「工具.移至定義」），其餘命令名稱裡完全
      沒有 SqlAssist 字樣，使用者搜不到也就改不了鍵。名稱一律 SqlAssist. 開頭，
      搜尋一次就列出本擴充的全部命令；命令視窗用英文那一個，鍵盤頁顯示的是
      LocCanonicalName。

      元素名稱是 LocCanonicalName——結構描述裡就叫這個。寫成 Localized… 那個長名
      會被編譯器**靜靜丟掉**：0 錯誤 0 警告、命令表照樣產生，鍵盤頁上卻什麼都沒變。
      要確認有沒有進去，把 obj 下的 Menus.cto 丟給 vsct.exe 反編譯，看得到那兩個
      元素才算數；`tools/Test-CommandTable.ps1` 也會擋下缺漏與寫錯的元素名稱。
    -->
    <Buttons>
      <Button guid="guidSqlAssistCommandSet" id="cmdidToggleEnabled" priority="0x0100" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistToggleGroup" />
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>啟用 SqlAssist</ButtonText>
          <CanonicalName>SqlAssist.ToggleEnabled</CanonicalName>
          <LocCanonicalName>SqlAssist.啟用</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCommandSet" id="cmdidToggleSuggestions" priority="0x0200" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistToggleGroup" />
        <Strings>
          <ButtonText>顯示即時建議</ButtonText>
          <CanonicalName>SqlAssist.ToggleSuggestions</CanonicalName>
          <LocCanonicalName>SqlAssist.顯示即時建議</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="guidSqlAssistCommandSet" id="cmdidGoToDefinition" priority="0x0100" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistActionsGroup" />
        <Strings>
          <ButtonText>移至定義</ButtonText>
          <CanonicalName>SqlAssist.GoToDefinition</CanonicalName>
          <LocCanonicalName>SqlAssist.移至定義</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCommandSet" id="cmdidShowObjectStructure" priority="0x0150" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistActionsGroup" />
        <Strings>
          <ButtonText>顯示游標處物件的結構</ButtonText>
          <CanonicalName>SqlAssist.ShowObjectStructure</CanonicalName>
          <LocCanonicalName>SqlAssist.顯示游標處物件的結構</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCommandSet" id="cmdidRefreshSuggestions" priority="0x0200" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistActionsGroup" />
        <Strings>
          <ButtonText>重新整理建議</ButtonText>
          <CanonicalName>SqlAssist.RefreshSuggestions</CanonicalName>
          <LocCanonicalName>SqlAssist.重新整理建議</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCommandSet" id="cmdidSurroundWith" priority="0x0250" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistActionsGroup" />
        <Strings>
          <ButtonText>以片段包住選取範圍</ButtonText>
          <CanonicalName>SqlAssist.SurroundWith</CanonicalName>
          <LocCanonicalName>SqlAssist.以片段包住選取範圍</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCommandSet" id="cmdidManageSnippets" priority="0x0300" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistActionsGroup" />
        <Strings>
          <ButtonText>程式碼片段…</ButtonText>
          <CanonicalName>SqlAssist.ManageSnippets</CanonicalName>
          <LocCanonicalName>SqlAssist.程式碼片段</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="guidSqlAssistCommandSet" id="cmdidOpenSettings" priority="0x0100" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistSupportGroup" />
        <Strings>
          <ButtonText>設定…</ButtonText>
          <CanonicalName>SqlAssist.OpenSettings</CanonicalName>
          <LocCanonicalName>SqlAssist.設定</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCommandSet" id="cmdidShowDiagnostics" priority="0x0200" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistSupportGroup" />
        <Strings>
          <ButtonText>關於與診斷…</ButtonText>
          <CanonicalName>SqlAssist.ShowDiagnostics</CanonicalName>
          <LocCanonicalName>SqlAssist.關於與診斷</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="guidSqlAssistCommandSet" id="cmdidOpenDiagnosticsLog" priority="0x0200" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistSettingsPageGroup" />
        <CommandFlag>CommandWellOnly</CommandFlag>
        <Strings>
          <ButtonText>開啟 SqlAssist 診斷紀錄檔</ButtonText>
          <CanonicalName>SqlAssist.OpenDiagnosticsLog</CanonicalName>
          <LocCanonicalName>SqlAssist.開啟診斷紀錄檔</LocCanonicalName>
        </Strings>
      </Button>

      <!-- 選色命令只從設定欄位旁啟動，不增加工具選單項目。 -->
      <Button guid="guidSqlAssistCommandSet" id="cmdidPickBlockAccent" priority="0x0300" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistSettingsPageGroup" />
        <CommandFlag>CommandWellOnly</CommandFlag>
        <Strings>
          <ButtonText>選取 SqlAssist 區塊共用基準色</ButtonText>
          <CanonicalName>SqlAssist.PickBlockAccent</CanonicalName>
          <LocCanonicalName>SqlAssist.選取區塊共用基準色</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCommandSet" id="cmdidPickBlockKeywordForeground" priority="0x0310" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistSettingsPageGroup" />
        <CommandFlag>CommandWellOnly</CommandFlag>
        <Strings>
          <ButtonText>選取 SqlAssist 全域高亮預設前景色</ButtonText>
          <CanonicalName>SqlAssist.PickBlockKeywordForeground</CanonicalName>
          <LocCanonicalName>SqlAssist.選取全域高亮預設前景色</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCommandSet" id="cmdidPickBlockKeywordBackground" priority="0x0320" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistSettingsPageGroup" />
        <CommandFlag>CommandWellOnly</CommandFlag>
        <Strings>
          <ButtonText>選取 SqlAssist 全域高亮預設背景色</ButtonText>
          <CanonicalName>SqlAssist.PickBlockKeywordBackground</CanonicalName>
          <LocCanonicalName>SqlAssist.選取全域高亮預設背景色</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCommandSet" id="cmdidPickBlockSymbolForeground" priority="0x0330" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistSettingsPageGroup" />
        <CommandFlag>CommandWellOnly</CommandFlag>
        <Strings>
          <ButtonText>選取 SqlAssist 符號高亮前景色</ButtonText>
          <CanonicalName>SqlAssist.PickBlockSymbolForeground</CanonicalName>
          <LocCanonicalName>SqlAssist.選取符號高亮前景色</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCommandSet" id="cmdidPickBlockSymbolBackground" priority="0x0340" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistSettingsPageGroup" />
        <CommandFlag>CommandWellOnly</CommandFlag>
        <Strings>
          <ButtonText>選取 SqlAssist 符號高亮背景色</ButtonText>
          <CanonicalName>SqlAssist.PickBlockSymbolBackground</CanonicalName>
          <LocCanonicalName>SqlAssist.選取符號高亮背景色</LocCanonicalName>
        </Strings>
      </Button>
      <!-- 第一組：產出進剪貼簿，接下來要按的是 Ctrl+V。 -->
      <Button guid="guidSqlAssistCommandSet" id="cmdidResultGridInPredicate" priority="0x0100" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistResultGridCopyGroup" />
        <Strings>
          <ButtonText>複製成 IN 條件</ButtonText>
          <CanonicalName>SqlAssist.ResultGridInPredicate</CanonicalName>
          <LocCanonicalName>SqlAssist.複製成IN條件</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCommandSet" id="cmdidResultGridMarkdown" priority="0x0200" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistResultGridCopyGroup" />
        <Strings>
          <ButtonText>複製成 Markdown 表格</ButtonText>
          <CanonicalName>SqlAssist.ResultGridMarkdown</CanonicalName>
          <LocCanonicalName>SqlAssist.複製成Markdown表格</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCommandSet" id="cmdidResultGridJson" priority="0x0300" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistResultGridCopyGroup" />
        <Strings>
          <ButtonText>複製成 JSON</ButtonText>
          <CanonicalName>SqlAssist.ResultGridJson</CanonicalName>
          <LocCanonicalName>SqlAssist.複製成JSON</LocCanonicalName>
        </Strings>
      </Button>

      <!--
        第二組：會開一個新的視窗，畫面跟著換掉。三項都帶刪節號，
        那是殼層一貫的「按下去還有下一個畫面」記號，與上面那一組的差別
        在選單上看得出來。
      -->
      <Button guid="guidSqlAssistCommandSet" id="cmdidResultGridTempTable" priority="0x0100" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistResultGridActionsGroup" />
        <Strings>
          <ButtonText>建立 #temp 指令碼（新視窗）…</ButtonText>
          <CanonicalName>SqlAssist.ResultGridTempTable</CanonicalName>
          <LocCanonicalName>SqlAssist.建立temp指令碼</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCommandSet" id="cmdidResultGridProfile" priority="0x0200" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistResultGridActionsGroup" />
        <Strings>
          <ButtonText>欄位剖析…</ButtonText>
          <CanonicalName>SqlAssist.ResultGridProfile</CanonicalName>
          <LocCanonicalName>SqlAssist.欄位剖析</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCommandSet" id="cmdidResultGridCell" priority="0x0300" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistResultGridActionsGroup" />
        <Strings>
          <ButtonText>檢視這一格完整內容…</ButtonText>
          <CanonicalName>SqlAssist.ResultGridCell</CanonicalName>
          <LocCanonicalName>SqlAssist.檢視這一格完整內容</LocCanonicalName>
        </Strings>
      </Button>

      <!--
        格線內部的探測。留著而不是刪掉：SSMS 換版之後這一組功能安靜地失效時，
        它是唯一問得出「格線還在不在、方法還叫不叫這個名字」的東西。
        只在「詳細記錄」打開時才出現，平常不佔使用者的選單。

        兩個旗標缺一不可，而少了它們的症狀是安靜的：殼層只有在命令標了
        DynamicVisibility 時才理會 QueryStatus 回報的「隱藏」，否則
        BeforeQueryStatus 把 Visible 設成 false 也沒有用，項目照樣出現在選單上
        ——沒有例外、沒有紀錄，而且從程式碼上看完全正確。
        DefaultInvisible 管的是另一半：套件還沒載入時，殼層照命令表的預設值畫。
      -->
      <Button guid="guidSqlAssistCommandSet" id="cmdidProbeResultGrid" priority="0x0100" type="Button">
        <Parent guid="guidSqlAssistCommandSet" id="SqlAssistResultGridDiagnosticsGroup" />
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>結果診斷資訊…</ButtonText>
          <CanonicalName>SqlAssist.ProbeResultGrid</CanonicalName>
          <LocCanonicalName>SqlAssist.結果診斷資訊</LocCanonicalName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <!--
    同一個命令要出現在第二個地方只能用 CommandPlacement：<Button> 的 <Parent> 只有
    一個，再宣告一顆按鈕則是另一個命令，狀態、鍵繫結與註冊檔都得再接一次，
    而兩份實作分岔的症狀是其中一個入口安靜地停在舊行為。
  -->
  <CommandPlacements>
    <CommandPlacement guid="guidSqlAssistCommandSet" id="cmdidSurroundWith" priority="0x0100">
      <Parent guid="guidSqlAssistCommandSet" id="SqlAssistEditorContextGroup" />
    </CommandPlacement>
  </CommandPlacements>

  <KeyBindings>
    <KeyBinding guid="guidSqlAssistCommandSet"
                id="cmdidToggleEnabled"
                editor="guidVSStd97"
                key1="S"
                mod1="Control Alt Shift" />
    <!--
      與 F12 使用同一條命令表路徑。SSMS 查詢視窗沒有一個可依賴的編輯器範圍，
      所以仍綁在全域範圍；命令處理器在 SqlAssist 停用或沒有 SQL 編輯器時回報停用，
      避免 Ctrl+Shift+D 在其他表面攔走殼層原本的行為。
    -->
    <KeyBinding guid="guidSqlAssistCommandSet"
                id="cmdidRefreshSuggestions"
                editor="guidVSStd97"
                key1="D"
                mod1="Control Shift" />
    <!--
      F12。實測 SSMS 22 沒有把 F12 綁在 Edit.GoToDefinition 上——濾鏡掛好了也從來
      收不到 VSStd97/GotoDefn，紀錄檔顯示命令是從這一條鍵繫結進來的。因此這裡不是
      備援，是唯一真正生效的路；拿掉它 F12 就完全沒有反應。

      全域範圍（guidVSStd97）而不是某個編輯器範圍：SSMS 的查詢視窗用的是它自己的
      編輯器工廠，猜錯 GUID 的症狀是繫結安靜地不生效。全域一定註冊得上，代價是
      在非 SQL 編輯器裡也綁到，因此命令自己要在沒有 SQL 編輯器時回報停用——
      停用的命令不會被派送，那些地方的 F12 就照常落回殼層。

      使用者若在「選項 → 鍵盤」把 Edit.GoToDefinition 綁到別的鍵，那一條由
      SqlShellCommandFilter 接，與這裡互斥（鍵繫結只會解析出一個命令）。
    -->
    <KeyBinding guid="guidSqlAssistCommandSet"
                id="cmdidGoToDefinition"
                editor="guidVSStd97"
                key1="VK_F12" />
    <!--
      Alt+F12 在 SSMS 22 實機上不會抵達命令表或命令濾鏡；改用 Ctrl+F12，並沿用
      F12 的全域範圍。命令狀態守門可避免在沒有 SQL 編輯器時攔走按鍵。
    -->
    <KeyBinding guid="guidSqlAssistCommandSet"
                id="cmdidShowObjectStructure"
                editor="guidVSStd97"
                key1="VK_F12"
                mod1="Control" />
    <!--
      包夾用 Ctrl+Alt+S，不用 Ctrl+K, Ctrl+S：後者在 SSMS 上解析得到的是它自己的
      Edit.SurroundWith，實測繫結搶不到，綁了只會變成「文件寫著卻按不出來」。
      同樣是全域範圍，理由與 F12 相同；命令在沒有選取或沒有 SQL 編輯器時回報停用，
      所以其他表面上的 Ctrl+Alt+S 照常落回殼層。使用者若自己把 Edit.SurroundWith
      綁到某個鍵，SqlShellCommandFilter 那條路仍然接得住，終點是同一份實作。
    -->
    <KeyBinding guid="guidSqlAssistCommandSet"
                id="cmdidSurroundWith"
                editor="guidVSStd97"
                key1="S"
                mod1="Control Alt" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidSqlAssistPackage" value="{b386e18d-f34b-4db4-a40d-b9092a31d89f}" />

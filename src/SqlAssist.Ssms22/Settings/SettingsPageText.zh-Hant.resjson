{
  // SSMS 設定頁上的文字：Title 是設定或頁面名稱，Description 是底下的說明，Item 是下拉選項。
  // 說明裡用「」引用的設定或頁面，英文要與那一項 Title 的譯文一字不差。
  "BlocksEnabledTitle": "啟用 T-SQL 區塊配對高亮",
  "BlocksEnabledDescription": "在起訖關鍵字上標示配對。SqlAssist 總開關關閉時也會停用。",
  "BlocksKeywordHighlightTitle": "配對端點高亮",
  "BlocksKeywordHighlightDescription": "游標位於端點時，以較明顯的前景與背景標示配對；不改動 SSMS 原生括號配色。",
  "BlocksKeywordForegroundTitle": "全域高亮預設前景色",
  "BlocksKeywordForegroundDescription": "所有配對端點共用；符號可在其種類底下覆寫。有效 #RRGGBB 字色保持原值，必要時調整背景以維持可讀性；留空才自動選字色，高對比模式除外。",
  // 色彩設定旁的按鈕，開啟選色對話框
  "ColorPickerCommand": "選取色彩…",
  "BlocksKeywordBackgroundTitle": "全域高亮預設背景色",
  "BlocksKeywordBackgroundDescription": "所有配對端點共用；符號可在其種類底下覆寫。留空使用共用基準色，支援 #RRGGBB，並自動適配深淺底色。",
  "BlocksSymbolForegroundTitle": "符號高亮前景色（括號、方括號、字串引號）",
  "BlocksSymbolForegroundDescription": "有效 #RRGGBB 字色保持原值，必要時調整背景；留空繼承全域高亮預設，高對比模式除外。需開啟配對端點高亮才會顯示。",
  "BlocksSymbolBackgroundTitle": "符號高亮背景色（括號、方括號、字串引號）",
  "BlocksSymbolBackgroundDescription": "留空繼承全域高亮預設；支援 #RRGGBB，並自動適配深淺底色。需開啟配對端點高亮才會顯示。",
  "BlocksRangeBackgroundTitle": "區間淡色背景",
  "BlocksRangeBackgroundDescription": "依基準色與實際編輯器底色推導淡色背景，不更改 SQL 字色；高對比模式不塗背景。",
  "BlocksAccentColorTitle": "共用基準色（背景、端點與指示條）",
  "BlocksAccentColorDescription": "留空跟隨 SSMS 主題；例如 #4F86C6，也可按鈕選色。供區間、未另設色的端點、邊欄、概覽與提示共用，因此不隸屬區間背景開關。無效格式回退主題，高對比忽略自訂色；原生導引線除外。",
  "BlocksRangeInsideTitle": "游標在區塊內也顯示最近一層背景",
  "BlocksRangeInsideDescription": "不必停在關鍵字上；只標示最近符合設定的一層，不疊加多層色彩。關閉後恢復只在端點顯示。",
  "BlocksStructureTitle": "結構導引線",
  "BlocksStructureDescription": "由 SSMS 繪製。色彩由環境的字型與色彩中「結構輔助線／Structure Guide Lines」的背景色管理，會影響所有原生結構導引線。",
  "BlocksOutliningTitle": "進階：補足 SSMS 未提供的區塊摺疊",
  "BlocksOutliningDescription": "只在原生缺少區塊 +/− 時使用，通常保持關閉。SSMS 本來就能摺疊 BEGIN／END 時，切換可能沒有可見差異；不會開關原生摺疊。",
  "BlocksGlyphsTitle": "行號邊欄指示條",
  "BlocksGlyphsDescription": "在游標所在區塊的每一行顯示指示條；啟用區間背景時跟隨同一層，不必停在關鍵字上。",
  "BlocksOverviewTitle": "捲軸概覽標記",
  "BlocksOverviewDescription": "游標位於區塊內即可在捲軸顯示起訖與範圍色帶，不必停在 BEGIN／END；跟隨背景範圍，背景關閉時仍可獨立顯示。",
  "BlocksContextHintTitle": "跨頁上下文提示",
  "BlocksContextHintDescription": "起始行已捲出畫面時顯示摘要；滑鼠移入呈現手形與連結色，點擊返回起始行，不占用鍵盤焦點或快捷鍵。",
  "BlocksSameLineBackgroundTitle": "同一行區塊也顯示背景色",
  "BlocksSameLineBackgroundDescription": "也顯示同行 CASE、括號或字串區間；關閉後略過同行區塊並保留外層跨行背景，不影響端點高亮。",
  "BlocksMatchParenthesesTitle": "納入配對種類：括號、方括號與字串引號",
  "BlocksMatchParenthesesDescription": "配對 ( )、[ ] 與 '…'（含 N'…'），同時影響所有區塊呈現。只取外框，字串內跳脫的 '' 與識別字內的 ]] 不當端點。",
  "BlocksMatchCaseTitle": "納入配對種類：CASE…END",
  "BlocksMatchCaseDescription": "同時影響所有區塊呈現；停用時仍解析 CASE，避免它的 END 被誤配到外層 BEGIN。",
  "BlocksDebounceTitle": "進階：Debounce 毫秒數",
  "BlocksDebounceDescription": "停止輸入多久後在背景更新配對；游標移動不重新解析。",
  "GeneralEnabledTitle": "啟用 SqlAssist",
  "GeneralEnabledDescription": "關閉後不顯示建議清單、不做關鍵字大寫、不展開任何語句，也不顯示物件結構。等同快捷鍵 Ctrl+Alt+Shift+S。",
  "GeneralUppercaseKeywordsOnTypeTitle": "輸入時把 T-SQL 關鍵字轉成大寫",
  "GeneralUppercaseKeywordsOnTypeDescription": "打完關鍵字並輸入空白或分隔字元時，把它改寫成大寫。與建議清單無關：關鍵字一律會列在清單裡。",
  "GeneralAutoPairDelimitersTitle": "自動補上成對的括號與引號",
  "GeneralAutoPairDelimitersDescription": "輸入 ( ' [ \" 時補上另一半並把游標留在中間；接著輸入結尾字元會跳過補上的那一個，Backspace 刪掉開頭字元時把空的另一半一起收掉，先選取一段文字再輸入開頭字元則是把它包起來。從建議清單提交自己帶著左括號的項目（GETDATE、varchar）時也一併補上右括號。字串與註解裡不配對，建議清單或程式碼片段欄位開著時也不介入。BEGIN…END 不在這一項底下，那是程式碼片段。",
  "GeneralCheckForUpdatesTitle": "啟動時檢查有沒有新版本",
  "GeneralCheckForUpdatesDescription": "每天最多問一次 GitHub 的發行頁，有新版才跳出提醒，略過的版本不再提醒；不下載也不安裝。關閉之後仍可用「工具 → SqlAssist → 檢查更新…」自己問。",
  "GeneralAnimationsTitle": "播放介面動畫",
  "GeneralAnimationsDescription": "SqlAssist 自製介面的所有動畫：通知的進出、明細、狀態圖示與進度條，結構預覽的淡入，以及 SQL Memory 的載入圖示與清單停駐效果。關閉後直接切到最終狀態。高對比模式一律不播放。",
  "GeneralIgnoreWindowsAnimationSettingTitle": "不受 Windows 動畫設定影響",
  "GeneralIgnoreWindowsAnimationSettingDescription": "Windows 關閉「在 Windows 中顯示動畫」（常見於遠端桌面或效能選項）時仍照常播放。只影響 SqlAssist，不更改 Windows 設定；關閉這一項則跟隨 Windows。",
  "SuggestionsEnabledTitle": "輸入時自動彈出建議清單",
  "SuggestionsEnabledDescription": "關閉後仍保留滑鼠停留提示、關鍵字大寫，以及工具選單的「顯示游標處物件的結構」。總開關在「一般」頁。",
  "SuggestionsSuppressNativeMemberListTitle": "只使用 SqlAssist 的建議清單",
  "SuggestionsSuppressNativeMemberListDescription": "SSMS 內建的 T-SQL IntelliSense 打字時會彈出自己的清單，兩份同時出現會互相干擾。開啟這一項只擋掉它自動彈出的清單，它的紅色錯誤波浪線、大綱與參數提示照常運作。做法是取消勾選 設定 → 語言 → Transact-SQL 裡的「自動列出成員」；在那裡勾回來，下次套用時會再被取消。請不要整個關閉 SSMS 的 T-SQL IntelliSense——那會連錯誤檢查一起關掉。",
  "SuggestionsTriggerAfterCharactersTitle": "輸入幾個字元後才彈出清單",
  "SuggestionsTriggerAfterCharactersDescription": "只影響沒有限定詞的位置。輸入 a. 這種指定別名或結構描述的位置一律立刻彈出。",
  "SuggestionsShowCategoryFiltersTitle": "在建議清單上方顯示分類篩選列",
  "SuggestionsShowCategoryFiltersDescription": "按下欄位、資料表、檢視等按鈕只看該分類，也可以按 Alt 加上按鈕的存取鍵。不選任何一顆就是全部。清單裡只有一種分類時不會出現。",
  "SuggestionsIncludeSnippetsTitle": "列出程式碼片段",
  "SuggestionsIncludeSnippetsDescription": "把內建與自訂的程式碼片段一起列進建議清單。內建片段共 49 筆。",
  // 設定旁的按鈕
  "SuggestionsIncludeSnippetsCommand": "編輯程式碼片段…",
  "SuggestionsIncludeDatabaseObjectsTitle": "列出資料庫物件與欄位",
  "SuggestionsIncludeDatabaseObjectsDescription": "關閉後完全不查詢連線的資料庫，清單只剩 T-SQL 關鍵字與程式碼片段。「插入與展開」頁的語句展開也會跟著沒有材料可用。",
  "InsertionQualifyObjectNamesTitle": "插入物件時補上結構描述名稱",
  "InsertionQualifyObjectNamesDescription": "例如插入 dbo.Lib_Reader 而不是 Lib_Reader。總開關在「一般」頁。",
  "InsertionUseSquareBracketsTitle": "插入物件時加上方括號",
  "InsertionUseSquareBracketsDescription": "例如插入 [dbo].[Lib_Reader]。關閉時仍會為含空白或保留字的名稱加上括號，否則插入的 SQL 無效。",
  "InsertionExpandWildcardOnTabTitle": "按 Tab 把 SELECT * 展開成欄位清單",
  "InsertionExpandWildcardOnTabDescription": "游標停在選取清單的 * 後方時顯示提示，按 Tab 換成完整欄位。支援資料表、檢視、子查詢與 CTE；a.* 只展開該來源，敘述有兩個以上來源時自動補上別名。只要有一個來源解析不出來就完全不展開。",
  // 列舉值 oneLineWhenShort
  "InsertionWildcardLayoutItemOneLineWhenShort": "放得下就排成一行，放不下才每欄一行",
  // 列舉值 onePerLine
  "InsertionWildcardLayoutItemOnePerLine": "永遠每欄一行",
  // 列舉值 fillWidth
  "InsertionWildcardLayoutItemFillWidth": "依行寬排滿，一行放多個欄位",
  "InsertionWildcardLayoutTitle": "SELECT * 展開後的欄位排版",
  "InsertionWildcardLayoutDescription": "每欄一行時，新增或移除欄位只會動到一行，比對版本差異最清楚。另外兩種的換行位置由欄位名稱的長度決定。",
  "InsertionExpandAlterDefinitionTitle": "在 ALTER 之後展開完整定義",
  "InsertionExpandAlterDefinitionDescription": "在 ALTER PROCEDURE、ALTER FUNCTION、ALTER VIEW、ALTER TRIGGER 之後選取物件時，把伺服器上目前的 CREATE 定義取回來改寫成 ALTER 整句貼上，游標停在名稱後面。定義取不到或不是 CREATE 開頭時維持只插入名稱。關閉後只插入名稱，也不會為此向伺服器查詢定義。",
  "InsertionExpandInsertStatementTitle": "在 INSERT INTO 之後展開完整的欄位與 VALUES",
  "InsertionExpandInsertStatementDescription": "選取資料表後不只補上名稱，而是展開成每列一個欄位的清單加上對應的 VALUES 預留值。IDENTITY、計算欄位、rowversion 與時態資料表的期間欄位會排除。關閉後只插入名稱。",
  "InsertionExpandMergeStatementTitle": "在 MERGE INTO 之後展開完整的比對鍵與動作子句",
  "InsertionExpandMergeStatementDescription": "選取目標資料表後展開成 ON 比對鍵、UPDATE SET、INSERT 與 VALUES；比對鍵取自主索引鍵，兩個動作子句都帶著 AND 1 = 0，確認條件之前不會真的改到資料。關閉後只插入名稱。",
  "InsertionExpandProcedureCallTitle": "在 EXEC 之後展開完整的參數清單",
  "InsertionExpandProcedureCallDescription": "選取預存程序後展開成具名傳值的呼叫，每個參數一列並註明型別；有預設值的參數標示為選擇性，OUTPUT 參數會一併補上 DECLARE。關閉後只插入名稱。",
  "InsertionIncludeOptionalParametersTitle": "EXEC 展開時包含選擇性參數",
  "InsertionIncludeOptionalParametersDescription": "關閉後只展開必填參數，在定義裡已經給了預設值的那些一律省略——省略選擇性參數本來就是合法的呼叫方式，參數很多的程序因此短得多。整支程序的參數都有預設值時就不展開了，維持只插入名稱。",
  "InsertionExpandFunctionCallTitle": "選取自訂函式後補上括號",
  "InsertionExpandFunctionCallDescription": "選取純量函式或資料表值函式後補上一對空括號，游標停在中間，接著由 SSMS 的「陳述式完成 → 參數資訊」告訴你要填什麼。函式的括號在 T-SQL 裡本來就非寫不可，沒有參數的函式也一樣要寫 ()。關閉後只插入名稱。",
  "InsertionExpandFunctionArgumentsTitle": "括號裡填入引數預留值",
  "InsertionExpandFunctionArgumentsDescription": "開啟後不只補括號，還依參數型別填入一整組預留值（數值 0、字串 ''、日期 NULL、uniqueidentifier NEWID()），游標停在第一個引數上。預設關閉：預留值只是照型別猜的，每一個接著都要換掉，而空括號讓 SSMS 的參數資訊接手告訴你參數叫什麼。",
  "StructureHoverEnabledTitle": "滑鼠停留時顯示物件結構",
  "StructureHoverEnabledDescription": "停在資料表、檢視、預存程序上時顯示欄位型別、NULL、主索引鍵等資訊。總開關在「一般」頁。",
  "StructureBuiltInHelpTitle": "滑鼠停留時顯示內建名稱的說明",
  "StructureBuiltInHelpDescription": "停在 CONVERT、DATEDIFF、NVARCHAR 這類內建名稱上時顯示引數順序、用途與一段範例。不查資料庫，沒有連線也看得到。",
  "StructureParameterHintTitle": "輸入自訂函式的引數時顯示參數提示",
  "StructureParameterHintDescription": "游標停在純量函式的括號裡時浮出一行簽章（dbo.dtoc(@ddate smalldatetime) RETURNS varchar(10)），目前輪到的引數以粗體標示，打逗號會跟著往下走。只做純量函式：內建函式與 FROM 後面的資料表值函式由 SSMS 自己的「陳述式完成 → 參數資訊」負責。",
  "StructureClickNavigationTitle": "Ctrl＋點擊物件名稱開啟結構預覽，加按 Shift 開啟定義",
  "StructureClickNavigationDescription": "按住 Ctrl 時，滑鼠下的物件名稱會加上底線、游標變成手指；點下去等於在那裡按 Ctrl+F12，加按 Shift 則等於按 F12。只接手物件名稱上的點擊，其他位置的 Ctrl＋點擊照舊選取整個單字。關閉後物件名稱上也照舊選取單字。",
  // 列舉值 delay
  "StructurePreviewModeItemDelay": "停留一段時間後自動展開",
  // 列舉值 rightArrow
  "StructurePreviewModeItemRightArrow": "按向右鍵才展開",
  // 列舉值 off
  "StructurePreviewModeItemOff": "不顯示浮動預覽",
  "StructurePreviewModeTitle": "建議清單的結構預覽何時展開",
  "StructurePreviewModeDescription": "向右鍵模式下，展開後跟著選取移動，按向左鍵收合。",
  "StructurePreviewDelayTitle": "自動展開前的停留毫秒數",
  "StructurePreviewDelayDescription": "用方向鍵快速掃過清單時，掃過去的項目不會展開，也不會送出查詢。",
  // 列舉值 stacked
  "StructurePreviewPlacementItemStacked": "建議清單的上下方，延伸到編輯器右側",
  // 列舉值 beside
  "StructurePreviewPlacementItemBeside": "貼在建議清單的側邊",
  "StructurePreviewPlacementTitle": "預覽視窗的位置",
  "StructurePreviewPlacementDescription": "上下擺放時，欄位很多的資料表可以一次攤開好幾欄而不必橫向捲動，代價是會蓋住上下幾行程式碼。",
  "StructurePreviewFontSizeTitle": "預覽視窗的字級",
  "StructurePreviewFontSizeDescription": "資料格、分頁與標題的基準字級，其餘字級按固定差距跟著走。指令碼分頁不受影響，它跟的是編輯器的字型與字級。",
  // 列舉值 fidelity
  "StructureScriptStyleItemFidelity": "還原度優先（條件約束獨立成敘述、每一段接 GO）",
  // 列舉值 ssmsNative
  "StructureScriptStyleItemSsmsNative": "與 SSMS 的「編寫指令碼為」一致",
  // 列舉值 minimal
  "StructureScriptStyleItemMinimal": "只留執行得起來所必需的部分",
  "StructureScriptStyleTitle": "產生指令碼的風格",
  "StructureScriptStyleDescription": "F12 與浮動預覽的指令碼分頁都用這一組。還原度優先那一組會寫出定序、識別值種子、預設值條件約束的名稱與檔案群組。",
  "StructureScriptIncludeExtendedPropertiesTitle": "指令碼包含資料行說明",
  "StructureScriptIncludeExtendedPropertiesDescription": "把 MS_Description 重建成 sp_addextendedproperty。資料表、資料行、索引與條件約束四層都會寫出來。",
  "StructureScriptIncludeAnalyzerCommentsTitle": "指令碼附上結構健檢的發現",
  "StructureScriptIncludeAnalyzerCommentsDescription": "在每個物件前面寫成 -- [SCHEMA-001][Warning] … 的註解。檢查的是 INCLUDE 帶大型物件、同語意資料行型別不一致、列舉欄位缺少 CHECK 這一類問題。",
  "StructureScriptIncludeHeaderCommentTitle": "指令碼附上來源檔頭",
  "StructureScriptIncludeHeaderCommentDescription": "在最前面寫出來源伺服器與資料庫、產生時間、工具版本與風格。存檔之後分得出這一份是從哪一台抓的。",
  "SqlMemoryEnabledTitle": "啟用 SQL Memory",
  "SqlMemoryEnabledDescription": "這一頁整組功能的開關：查詢歷程、草稿、當機還原、收藏與背景維護。SQL 只存進這台電腦上的資料庫，不上傳。關閉時完全不擷取，也不執行背景整理。需要「一般」頁的「啟用 SqlAssist」也開著。",
  "SqlMemoryCaptureExecutedTitle": "擷取：執行過的查詢",
  "SqlMemoryCaptureExecutedDescription": "按下執行時保存當下的 SQL 與連線的伺服器、資料庫名稱；不保存密碼或連線字串。",
  "SqlMemoryCaptureDraftsTitle": "擷取：尚未執行的草稿",
  "SqlMemoryCaptureDraftsDescription": "停止輸入一段時間後保存目前內容。關閉之後只有執行過的 SQL 留得下來。",
  "SqlMemoryCaptureRecoveryTitle": "擷取：未存檔內容（當機還原）",
  "SqlMemoryCaptureRecoveryDescription": "每個查詢視窗各留一份最新內容，正常關閉時移除。關閉之後 SSMS 意外結束的未存檔內容救不回來。",
  "SqlMemoryIdleSecondsTitle": "草稿：停止輸入幾秒後記下",
  "SqlMemoryIdleSecondsDescription": "越短越不容易漏掉剛打的內容，代價是背景寫入變頻繁。",
  "SqlMemoryAutoRevisionMinutesTitle": "草稿：最密幾分鐘留一個版本",
  "SqlMemoryAutoRevisionMinutesDescription": "內容有變才留；這個間隔內的多次修改併成同一個版本。執行與手動快照不受限制。",
  "SqlMemoryDraftRetentionDaysTitle": "保留：草稿天數",
  "SqlMemoryDraftRetentionDaysDescription": "超過就從歷程清單移除。收藏、釘選與手動快照不受期限影響。",
  "SqlMemoryExecutionRetentionDaysTitle": "保留：執行紀錄天數",
  "SqlMemoryExecutionRetentionDaysDescription": "執行事件與草稿分開計算；查「上個月那一段跑過什麼」靠的是這一項。",
  "SqlMemoryRecoveryRetentionDaysTitle": "保留：無人使用的未存檔內容天數",
  "SqlMemoryRecoveryRetentionDaysDescription": "只算沒有任何 SSMS 還開著它的那些；還開著的查詢視窗不論多久都保留。",
  "SqlMemoryMaxExecutionsTitle": "上限：執行紀錄筆數",
  "SqlMemoryMaxExecutionsDescription": "與保留天數取聯集：期限內但超過筆數的舊紀錄也會移除。",
  "SqlMemoryMaxSessionRevisionsTitle": "上限：每個查詢視窗的自動版本數",
  "SqlMemoryMaxSessionRevisionsDescription": "只算自動留下的版本；執行、關閉與手動快照不算在內。",
  "SqlMemoryMaxFavoriteRevisionsTitle": "上限：每個收藏的編輯版本數",
  "SqlMemoryMaxFavoriteRevisionsDescription": "收藏的 SQL 每編輯一次留一個版本；目前這一個永遠保留。",
  // 列舉值 mb256
  "SqlMemoryStorageLimitItemMb256": "256 MB",
  // 列舉值 mb512
  "SqlMemoryStorageLimitItemMb512": "512 MB",
  // 列舉值 gb1
  "SqlMemoryStorageLimitItemGb1": "1 GB",
  // 列舉值 unlimited
  "SqlMemoryStorageLimitItemUnlimited": "不限",
  "SqlMemoryStorageLimitTitle": "儲存：容量上限",
  "SqlMemoryStorageLimitDescription": "超過之後背景整理會逐級縮短上面幾項保留，直到回到上限內。這不是硬性磁碟配額：收藏、釘選與還開著的查詢視窗永遠不會為了空間被刪。",
  "SqlMemoryMaintenanceMinutesTitle": "儲存：背景整理間隔",
  "SqlMemoryMaintenanceMinutesDescription": "背景清理的間隔。SSMS 閒置時可能提前，一次只處理有限筆數，不會卡住編輯。",
  "NotificationsEnabledTitle": "顯示通知提示",
  "NotificationsEnabledDescription": "在作用中查詢視窗所在視窗的右下角顯示執行中與近期完成的工作，以及需要你決定的提醒。",
  "NotificationsGlassTitle": "玻璃材質",
  "NotificationsGlassDescription": "使用主題色的層次邊緣；高對比一律使用不透明材質。",
  "NotificationsDelayTitle": "顯示延遲（毫秒）",
  "NotificationsDelayDescription": "延遲顯示提示；預設立即顯示。",
  "NotificationsRetentionTitle": "完成保留時間（毫秒）",
  "NotificationsRetentionDescription": "完成項目到期後同時從完成數與總數扣除；失敗與部分成功至少保留六秒。",
  // 列舉值 quiet
  "NotificationsVerbosityItemQuiet": "安靜：只留下值得知道的事",
  // 列舉值 normal
  "NotificationsVerbosityItemNormal": "一般：顯示各項工作",
  // 列舉值 verbose
  "NotificationsVerbosityItemVerbose": "詳細：連逐次的細節工作都顯示",
  // 列舉值 all
  "NotificationsVerbosityItemAll": "全部：連只進診斷統計的追蹤工作也顯示",
  "NotificationsVerbosityTitle": "詳細度",
  "NotificationsVerbosityDescription": "決定工作要到哪一階才上畫面。你剛觸發的動作、失敗與部分成功不受這個門檻影響；「全部」會把打字時的追蹤工作也放上來。",
  "NotificationsMetadataTitle": "中繼資料載入",
  "NotificationsMetadataDescription": "自動發生的物件、欄位、定序與快取查詢；不包含快取命中。",
  "NotificationsCompletionTitle": "建議清單",
  "NotificationsCompletionDescription": "輸入時準備、排序建議清單與參數提示；預設隱藏高頻提示。",
  "NotificationsAnalysisTitle": "語法與區塊分析",
  "NotificationsAnalysisDescription": "輸入時反覆執行的 T-SQL 分析；預設隱藏以減少干擾。",
  "NotificationsPreviewTitle": "物件提示與結構預覽",
  "NotificationsPreviewDescription": "滑鼠停留提示與浮動結構預覽自己的載入工作。",
  "NotificationsPackageTitle": "初始化與連線",
  "NotificationsPackageDescription": "啟動 SqlAssist 的準備工作、建立與重新確認中繼資料連線。",
  "NotificationsEditingTitle": "編輯與展開",
  "NotificationsEditingDescription": "按 Tab 展開 SELECT *、展開語句樣板與自動配對這類寫回編輯器的工作。",
  "NotificationsNavigationTitle": "移至定義",
  "NotificationsNavigationDescription": "F12 產生定義並另開查詢視窗的過程。",
  "NotificationsResultsTitle": "結果格線",
  "NotificationsResultsDescription": "從查詢結果產生指令碼、複製完整內容與剖析欄位。",
  "NotificationsSnippetsTitle": "程式碼片段",
  "NotificationsSnippetsDescription": "載入、儲存與還原內建及自訂片段。",
  "NotificationsSettingsTitle": "設定",
  "NotificationsSettingsDescription": "重新讀取設定與套用到編輯器的結果回饋。",
  "NotificationsSqlMemoryTitle": "SQL Memory",
  "NotificationsSqlMemoryDescription": "啟用、整理、清除與備份 SQL Memory，以及擷取被略過與容量警戒這類事件。",
  "NotificationsSearchTitle": "SQL Search",
  "NotificationsSearchDescription": "SQL Search 的複製、套用查詢視窗連線、搜尋失敗與預覽標不齊命中。移至定義與在物件總管中選取歸在「移至定義」。",
  "NotificationsUnclassifiedTitle": "未分類",
  "NotificationsUnclassifiedDescription": "還沒歸類的工作。預設顯示，關掉之後新加入的工作可能整批安靜消失。",
  "NotificationsFailuresTitle": "顯示所有種類的失敗",
  "NotificationsFailuresDescription": "獨立控制錯誤提示，即使該種類已隱藏仍可顯示；不影響診斷紀錄。",
  "NotificationsDegradedTitle": "顯示部分成功",
  "NotificationsDegradedDescription": "主要結果拿到了、但有一部分資料取不到的工作；關掉之後它們併回一般成功。",
  "DiagnosticsVerboseLoggingTitle": "寫入詳細診斷紀錄",
  "DiagnosticsVerboseLoggingDescription": "把逐次建議與提交的細節寫入 %LOCALAPPDATA%\\SqlAssist.Ssms22\\SqlAssist.log。回報問題時再開啟。",
  "CategoryNotificationsTitle": "通知與背景工作",
  "CategoryNotificationsDescription": "右下角的通知島，顯示全套件正在做、剛做完與需要你決定的事。",
  "CategorySqlAssistTitle": "SqlAssist",
  "CategorySqlAssistDescription": "T-SQL 即時建議、程式碼片段與資料庫物件結構預覽。",
  "CategoryGeneralTitle": "一般",
  "CategoryGeneralDescription": "總開關、輸入時的改寫、更新檢查與全套件的介面動畫。關閉「啟用 SqlAssist」會一併停用下面各頁的所有功能。",
  "CategorySuggestionsTitle": "建議清單",
  "CategorySuggestionsDescription": "清單什麼時候彈出來、裡面列些什麼。選取之後插進編輯器的文字長什麼樣在「插入與展開」頁。",
  "CategorySuggestionsMessage": "SSMS 的 T-SQL IntelliSense 請保持開啟——紅色錯誤波浪線與大綱都在它底下。「只使用 SqlAssist 的建議清單」已經擋掉它會互搶的那一部分。目前狀態見「工具 → SqlAssist → 關於與診斷…」。",
  "CategoryInsertionTitle": "插入與展開",
  "CategoryInsertionDescription": "決定最後寫進編輯器的是什麼文字：物件名稱的寫法、SELECT * 展開成欄位，以及五種語句展開。總開關在「一般」頁，語句展開另外需要「建議清單」頁的清單開著。",
  "CategoryStructureTitle": "物件結構",
  "CategoryStructureDescription": "滑鼠停留提示與建議清單旁的浮動結構預覽，兩者互不影響。總開關在「一般」頁。",
  "CategoryBlocksTitle": "區塊配對",
  "CategoryBlocksDescription": "T-SQL 起訖關鍵字與括號高亮。",
  "CategorySqlMemoryTitle": "SQL Memory",
  "CategorySqlMemoryDescription": "把查詢視窗的 SQL 留在這台電腦的資料庫，供之後查閱、還原與收藏。第一次開始擷取時會出現一則通知。總開關在「一般」頁。",
  // 設定旁的按鈕
  "CategorySqlMemoryCommand": "開啟 SQL Memory 用量…",
  "CategoryDiagnosticsTitle": "診斷",
  // 設定旁的按鈕
  "CategoryDiagnosticsCommand": "開啟診斷紀錄檔"
}

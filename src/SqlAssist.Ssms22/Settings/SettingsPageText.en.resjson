{
  "BlocksEnabledTitle": "Enable T-SQL block matching highlights",
  "BlocksEnabledDescription": "Highlights matching start and end keywords. Also off when the SqlAssist master switch is off.",
  "BlocksKeywordHighlightTitle": "Highlight matching endpoints",
  "BlocksKeywordHighlightDescription": "When the cursor is at an endpoint, highlights the matching pair with more prominent foreground and background colors; doesn't change SSMS's native parenthesis colors.",
  "BlocksKeywordForegroundTitle": "Default highlight foreground color",
  "BlocksKeywordForegroundDescription": "Shared by all matching endpoints; symbols can override it under their own kind. A valid #RRGGBB text color is kept as is and the background is adjusted for readability if needed; leave empty to pick the text color automatically, except in high contrast mode.",
  "ColorPickerCommand": "Pick color...",
  "BlocksKeywordBackgroundTitle": "Default highlight background color",
  "BlocksKeywordBackgroundDescription": "Shared by all matching endpoints; symbols can override it under their own kind. Leave empty to use the shared base color. Supports #RRGGBB and adapts to light and dark backgrounds.",
  "BlocksSymbolForegroundTitle": "Symbol highlight foreground color (parentheses, brackets, string quotes)",
  "BlocksSymbolForegroundDescription": "A valid #RRGGBB text color is kept as is and the background is adjusted if needed; leave empty to inherit the default highlight, except in high contrast mode. Shown only when \"Highlight matching endpoints\" is on.",
  "BlocksSymbolBackgroundTitle": "Symbol highlight background color (parentheses, brackets, string quotes)",
  "BlocksSymbolBackgroundDescription": "Leave empty to inherit the default highlight. Supports #RRGGBB and adapts to light and dark backgrounds. Shown only when \"Highlight matching endpoints\" is on.",
  "BlocksRangeBackgroundTitle": "Light background for block ranges",
  "BlocksRangeBackgroundDescription": "Derives a light background from the base color and the actual editor background without changing SQL text colors. No background in high contrast mode.",
  "BlocksAccentColorTitle": "Shared base color (background, endpoints, and indicators)",
  "BlocksAccentColorDescription": "Leave empty to follow the SSMS theme, or enter a color such as #4F86C6, or use the button. Shared by ranges, endpoints without their own color, the margin, the scroll bar overview, and hints, so it isn't controlled by the range background switch. Not used by native structure guide lines. Invalid values fall back to the theme; high contrast mode ignores custom colors.",
  "BlocksRangeInsideTitle": "Show the nearest block background while the cursor is inside it",
  "BlocksRangeInsideDescription": "The cursor doesn't have to be on a keyword. Only the nearest matching level is shaded; colors don't stack. When off, backgrounds appear only at endpoints.",
  "BlocksStructureTitle": "Structure guide lines",
  "BlocksStructureDescription": "Drawn by SSMS. Color is managed by the background color of \"Structure Guide Lines\" in Environment > Fonts and Colors; affects all native structure guide lines.",
  "BlocksOutliningTitle": "Advanced: add block outlining that SSMS doesn't provide",
  "BlocksOutliningDescription": "Use only when SSMS shows no block +/− controls; usually keep off. When SSMS can already collapse BEGIN/END, toggling may make no visible difference. Doesn't turn native outlining on or off.",
  "BlocksGlyphsTitle": "Line number margin indicators",
  "BlocksGlyphsDescription": "Shows an indicator on every line of the block that contains the cursor. With range backgrounds on, it follows the same level; the cursor doesn't have to be on a keyword.",
  "BlocksOverviewTitle": "Scrollbar overview markers",
  "BlocksOverviewDescription": "Shows the start, end, and range band on the scroll bar whenever the cursor is inside a block, without stopping on BEGIN/END. Follows the background range, and still works when backgrounds are off.",
  "BlocksContextHintTitle": "Off-screen block start hint",
  "BlocksContextHintDescription": "Shows a summary when the start line has scrolled out of view. Hovering shows a hand cursor and link color; clicking returns to the start line. Doesn't take keyboard focus or shortcuts.",
  "BlocksSameLineBackgroundTitle": "Show background color for blocks on the same line",
  "BlocksSameLineBackgroundDescription": "Also shades CASE, parentheses, and strings on a single line. When off, single-line blocks are skipped and the outer multi-line background is kept; endpoint highlights aren't affected.",
  "BlocksMatchParenthesesTitle": "Include in matching: parentheses, brackets, and string quotes",
  "BlocksMatchParenthesesDescription": "Matches ( ), [ ], and '…' (including N'…'); affects all block rendering. Only the outer delimiters count; escaped '' within strings and ]] within identifiers don't count as endpoints.",
  "BlocksMatchCaseTitle": "Include in matching: CASE…END",
  "BlocksMatchCaseDescription": "Affects all block rendering. When off, CASE is still parsed so that its END isn't matched to an outer BEGIN.",
  "BlocksDebounceTitle": "Advanced: debounce delay (ms)",
  "BlocksDebounceDescription": "How long after you stop typing to update matches in the background. Moving the cursor doesn't reparse.",
  "GeneralEnabledTitle": "Enable SqlAssist",
  "GeneralEnabledDescription": "When off, no suggestion list, no keyword uppercasing, no statement expansion, and no object structure. Same as the Ctrl+Alt+Shift+S shortcut.",
  "GeneralUppercaseKeywordsOnTypeTitle": "Uppercase T-SQL keywords while typing",
  "GeneralUppercaseKeywordsOnTypeDescription": "Rewrites keywords to uppercase after you type them and enter a space or delimiter. Unrelated to the suggestion list: keywords always appear in the list.",
  "GeneralAutoPairDelimitersTitle": "Auto-pair parentheses and quotes",
  "GeneralAutoPairDelimitersDescription": "Typing ( ' [ \" adds the closing character and leaves the cursor in between. Typing the closing character then steps over the added one; Backspace on the opening character also removes an empty closing one; typing an opening character with text selected wraps the selection. Committing a suggestion that brings its own opening parenthesis (GETDATE, varchar) also adds the closing one. No pairing inside strings and comments, or while the suggestion list or a code snippet field is active. BEGIN…END isn't handled here; it's a code snippet.",
  "GeneralCheckForUpdatesTitle": "Check for updates on startup",
  "GeneralCheckForUpdatesDescription": "Checks the GitHub releases page at most once a day and shows a prompt only when there's a new version; skipped versions aren't offered again. Never downloads or installs anything. When off, you can still check from \"Tools > SqlAssist > Check for Updates...\".",
  "GeneralAnimationsTitle": "Play UI animations",
  "GeneralAnimationsDescription": "All animations in SqlAssist's own UI: notifications appearing and leaving, details, status icons and progress bars, the structure preview fade-in, and SQL Memory loading icons and list effects. When off, everything jumps to its final state. Never animated in high contrast mode.",
  "GeneralIgnoreWindowsAnimationSettingTitle": "Ignore Windows animation setting",
  "GeneralIgnoreWindowsAnimationSettingDescription": "Keeps playing animations when Windows has \"Show animations in Windows\" turned off (common on Remote Desktop or with performance options). Affects only SqlAssist and doesn't change Windows settings; turn this off to follow Windows.",
  "GeneralLanguageTitle": "Interface language",
  "GeneralLanguageDescription": "Language for SqlAssist's own interface: suggestion lists, tooltips, notifications, tool windows, menu commands, and comments in generated scripts. \"Follow SSMS\" picks it from the SSMS display language: Chinese uses Traditional Chinese, any other language uses English. Takes effect immediately; this settings page and the extension list always follow SSMS.",
  "GeneralLanguageItemAuto": "Follow SSMS",
  "GeneralLanguageItemZhHant": "Traditional Chinese",
  "GeneralLanguageItemEn": "English",
  "SuggestionsEnabledTitle": "Automatically show suggestion list while typing",
  "SuggestionsEnabledDescription": "When off, Quick Info, keyword uppercasing, and \"Show Structure of Object at Cursor\" on the Tools menu still work. The master switch is on the \"General\" page.",
  "SuggestionsSuppressNativeMemberListTitle": "Use only the SqlAssist suggestion list",
  "SuggestionsSuppressNativeMemberListDescription": "SSMS's built-in T-SQL IntelliSense pops up its own list as you type, and two lists at once get in each other's way. This blocks only its automatic list; its red error squiggles, outlining, and parameter info keep working. It works by clearing \"Auto list members\" under Settings > Languages > Transact-SQL; if you check it again there, it's cleared on the next apply. Don't turn off SSMS's T-SQL IntelliSense entirely—that also turns off error checking.",
  "SuggestionsTriggerAfterCharactersTitle": "Characters to type before the list appears",
  "SuggestionsTriggerAfterCharactersDescription": "Applies only where there's no qualifier. After an alias or schema such as a., the list always appears immediately.",
  "SuggestionsShowCategoryFiltersTitle": "Show category filter buttons above the suggestion list",
  "SuggestionsShowCategoryFiltersDescription": "Click Columns, Tables, Views, and so on to show only that category, or select multiple; you can also press Alt plus the button's position from left to right (Alt+1 to Alt+9; the tenth is Alt+0). With nothing selected, everything is shown. Categories with no matches for what you type are grayed out. Hidden when the list has only one category.",
  "SuggestionsIncludeSnippetsTitle": "List code snippets",
  "SuggestionsIncludeSnippetsDescription": "Lists built-in and custom code snippets in the suggestion list. There are 49 built-in snippets.",
  "SuggestionsIncludeSnippetsCommand": "Edit code snippets...",
  "SuggestionsIncludeDatabaseObjectsTitle": "List database objects and columns",
  "SuggestionsIncludeDatabaseObjectsDescription": "When off, the connected database is never queried and the list has only T-SQL keywords and code snippets. Statement expansion on the \"Insertion and expansion\" page then has nothing to work with either.",
  "InsertionQualifyObjectNamesTitle": "Qualify object names with schema when inserting",
  "InsertionQualifyObjectNamesDescription": "For example, inserts dbo.Lib_Reader instead of Lib_Reader. The master switch is on the \"General\" page.",
  "InsertionUseSquareBracketsTitle": "Add square brackets when inserting objects",
  "InsertionUseSquareBracketsDescription": "For example, inserts [dbo].[Lib_Reader]. When disabled, still adds brackets to names containing spaces or reserved words to keep the SQL valid.",
  "InsertionExpandWildcardOnTabTitle": "Press Tab to expand SELECT * into a column list",
  "InsertionExpandWildcardOnTabDescription": "When the cursor is right after * in a select list, a hint appears and Tab replaces it with the full column list. Works with tables, views, subqueries, and CTEs; a.* expands only that source, and aliases are added when the statement has two or more sources. Nothing is expanded if any source can't be resolved.",
  "InsertionWildcardLayoutItemOneLineWhenShort": "Fit on one line if possible, otherwise one column per line",
  "InsertionWildcardLayoutItemOnePerLine": "Always one column per line",
  "InsertionWildcardLayoutItemFillWidth": "Fill line width with multiple columns per line",
  "InsertionWildcardLayoutTitle": "Column layout after expanding SELECT *",
  "InsertionWildcardLayoutDescription": "With one column per line, adding or removing columns touches only one line, making version diffs clearest. The other two layouts decide line breaks by column name length.",
  "InsertionExpandAlterDefinitionTitle": "Expand full definition after ALTER",
  "InsertionExpandAlterDefinitionDescription": "After ALTER PROCEDURE, ALTER FUNCTION, ALTER VIEW, or ALTER TRIGGER, picking an object fetches its current CREATE definition from the server, rewrites it as a full ALTER statement, and leaves the cursor after the name. If the definition can't be fetched or doesn't start with CREATE, only the name is inserted. When off, only the name is inserted and no definition is queried.",
  "InsertionExpandInsertStatementTitle": "Expand full columns and VALUES after INSERT INTO",
  "InsertionExpandInsertStatementDescription": "After you pick a table, inserts one column per line plus matching VALUES placeholders instead of just the name. IDENTITY, computed, rowversion, and temporal period columns are excluded. When off, only the name is inserted.",
  "InsertionExpandMergeStatementTitle": "Expand the full match keys and action clauses after MERGE INTO",
  "InsertionExpandMergeStatementDescription": "After you pick the target table, expands into the ON match keys, UPDATE SET, INSERT, and VALUES. Match keys come from the primary key, and both action clauses carry AND 1 = 0 so no data changes until you confirm the conditions. When off, only the name is inserted.",
  "InsertionExpandProcedureCallTitle": "Expand full parameter list after EXEC",
  "InsertionExpandProcedureCallDescription": "After you pick a stored procedure, expands into a call with named arguments, one parameter per line with its type. Parameters with defaults are marked optional, and OUTPUT parameters also get a DECLARE. When off, only the name is inserted.",
  "InsertionIncludeOptionalParametersTitle": "Include optional parameters in EXEC expansion",
  "InsertionIncludeOptionalParametersDescription": "When off, only required parameters are expanded; those with defaults in the definition are left out. Omitting optional parameters is a valid call, and procedures with many parameters get much shorter. If every parameter has a default, nothing is expanded and only the name is inserted.",
  "InsertionExpandFunctionCallTitle": "Add parentheses after picking a user-defined function",
  "InsertionExpandFunctionCallDescription": "After you pick a scalar or table-valued function, adds an empty pair of parentheses with the cursor inside, and SSMS's Statement completion > Parameter information tells you what to fill in. T-SQL requires the parentheses even for functions without parameters. When off, only the name is inserted.",
  "InsertionExpandFunctionArgumentsTitle": "Fill parentheses with argument placeholders",
  "InsertionExpandFunctionArgumentsDescription": "Besides the parentheses, fills in a full set of placeholders by parameter type (0 for numbers, '' for strings, NULL for dates, NEWID() for uniqueidentifier) with the cursor on the first argument. Off by default: the placeholders are only guesses by type and each has to be replaced anyway, while empty parentheses let SSMS's parameter information tell you the parameter names.",
  "StructureHoverEnabledTitle": "Show object structure on hover",
  "StructureHoverEnabledDescription": "Hovering over a table, view, or stored procedure shows column types, nullability, the primary key, and more. The master switch is on the \"General\" page.",
  "StructureBuiltInHelpTitle": "Show help for built-in names on hover",
  "StructureBuiltInHelpDescription": "Hovering over built-in names such as CONVERT, DATEDIFF, and NVARCHAR shows argument order, purpose, and an example. Doesn't query the database, so it works without a connection.",
  "StructureParameterHintTitle": "Keep parameter info visible while typing function arguments",
  "StructureParameterHintDescription": "Inside the parentheses of a scalar function, shows a one-line signature (dbo.dtoc(@ddate smalldatetime) RETURNS varchar(10)) with the current argument in bold; typing a comma moves to the next. Built-in functions and table-valued functions after FROM use SSMS's own Statement completion > Parameter information; when deleting, a mouse click, or undo closes it while the caret is still inside the parentheses, it is brought back. After Esc inside the parentheses, it stays closed until the caret leaves them.",
  "StructureClickNavigationTitle": "Ctrl+click an object name to preview its structure; add Shift to open its definition",
  "StructureClickNavigationDescription": "While Ctrl is held, the object name under the mouse is underlined and the pointer becomes a hand; clicking is the same as Ctrl+F12 there, and adding Shift is the same as F12. Only clicks on object names are taken over; Ctrl+click elsewhere still selects the word. When off, Ctrl+click on object names also selects the word.",
  "StructurePreviewModeItemDelay": "Expand automatically after a pause",
  "StructurePreviewModeItemRightArrow": "Expand with the Right Arrow key",
  "StructurePreviewModeItemOff": "Don't show floating preview",
  "StructurePreviewModeTitle": "When to expand the structure preview in the suggestion list",
  "StructurePreviewModeDescription": "In Right Arrow mode, the expanded preview follows the selection; press Left Arrow to collapse it.",
  "StructurePreviewDelayTitle": "Delay before expanding automatically (ms)",
  "StructurePreviewDelayDescription": "Items you pass over quickly with the arrow keys don't expand or send queries.",
  "StructurePreviewPlacementItemStacked": "Above or below the suggestion list, extending to the right edge of the editor",
  "StructurePreviewPlacementItemBeside": "Beside the suggestion list",
  "StructurePreviewPlacementTitle": "Preview window position",
  "StructurePreviewPlacementDescription": "Above or below, tables with many columns can spread across several columns without horizontal scrolling, at the cost of covering a few lines of code.",
  "StructurePreviewFontSizeTitle": "Preview window font size",
  "StructurePreviewFontSizeDescription": "Base size for grid cells, tabs, and headings; other sizes follow at fixed offsets. The Script tab isn't affected; it follows the editor's font and size.",
  "StructureScriptStyleItemFidelity": "Fidelity first (constraints as separate statements, GO after each batch)",
  "StructureScriptStyleItemSsmsNative": "Match SSMS \"Script As\"",
  "StructureScriptStyleItemMinimal": "Only what's needed to run",
  "StructureScriptStyleTitle": "Style for generated scripts",
  "StructureScriptStyleDescription": "Used by F12 and the Script tab of the floating preview. Fidelity first writes collations, identity seeds, default constraint names, and filegroups.",
  "StructureScriptIncludeExtendedPropertiesTitle": "Include column descriptions in scripts",
  "StructureScriptIncludeExtendedPropertiesDescription": "Recreates MS_Description as sp_addextendedproperty for tables, columns, indexes, and constraints.",
  "StructureScriptIncludeAnalyzerCommentsTitle": "Include schema check findings in scripts",
  "StructureScriptIncludeAnalyzerCommentsDescription": "Writes a comment such as -- [SCHEMA-001][Warning] … before each object. Checks for problems like large object columns in INCLUDE, columns with the same meaning but different types, and code columns without a CHECK constraint.",
  "StructureScriptIncludeHeaderCommentTitle": "Include a source header in scripts",
  "StructureScriptIncludeHeaderCommentDescription": "Writes the source server and database, generation time, tool version, and style at the top, so a saved script shows which server it came from.",
  "SqlMemoryEnabledTitle": "Enable SQL Memory",
  "SqlMemoryEnabledDescription": "Turns this whole page on or off: query history, drafts, crash recovery, favorites, and background maintenance. SQL is stored only in a database on this computer and is never uploaded. When off, nothing is captured and no background cleanup runs. Also requires \"Enable SqlAssist\" on the \"General\" page.",
  "SqlMemoryCaptureExecutedTitle": "Capture: executed queries",
  "SqlMemoryCaptureExecutedDescription": "When you execute, saves the SQL along with the connected server and database names. Passwords and connection strings aren't saved.",
  "SqlMemoryCaptureDraftsTitle": "Capture: drafts not yet executed",
  "SqlMemoryCaptureDraftsDescription": "Saves the current content after you stop typing for a while. When off, only executed SQL is kept.",
  "SqlMemoryCaptureRecoveryTitle": "Capture: unsaved content (crash recovery)",
  "SqlMemoryCaptureRecoveryDescription": "Keeps the latest content of each query window and removes it when the window closes normally. When off, unsaved content can't be recovered after SSMS exits unexpectedly.",
  "SqlMemoryIdleSecondsTitle": "Drafts: seconds after typing stops",
  "SqlMemoryIdleSecondsDescription": "Shorter means less chance of losing what you just typed, at the cost of more frequent background writes.",
  "SqlMemoryAutoRevisionMinutesTitle": "Drafts: minimum minutes between revisions",
  "SqlMemoryAutoRevisionMinutesDescription": "A revision is kept only when the content changed; edits within this interval merge into one revision. Executions and manual snapshots aren't limited.",
  "SqlMemoryDraftRetentionDaysTitle": "Retention: days to keep drafts",
  "SqlMemoryDraftRetentionDaysDescription": "Older drafts are removed from the history list. Favorites, pinned items, and manual snapshots never expire.",
  "SqlMemoryExecutionRetentionDaysTitle": "Retention: days to keep execution history",
  "SqlMemoryExecutionRetentionDaysDescription": "Counted separately from drafts; this is what answers \"what did I run last month?\"",
  "SqlMemoryRecoveryRetentionDaysTitle": "Retention: days to keep unused unsaved content",
  "SqlMemoryRecoveryRetentionDaysDescription": "Counts only content that no running SSMS still has open; open query windows are kept no matter how old.",
  "SqlMemoryMaxExecutionsTitle": "Limit: execution history entries",
  "SqlMemoryMaxExecutionsDescription": "Applies together with the retention days: old entries within the period are also removed once the count is exceeded.",
  "SqlMemoryMaxSessionRevisionsTitle": "Limit: automatic revisions per query window",
  "SqlMemoryMaxSessionRevisionsDescription": "Counts only automatic revisions; executions, closes, and manual snapshots don't count.",
  "SqlMemoryMaxFavoriteRevisionsTitle": "Limit: edit revisions per favorite",
  "SqlMemoryMaxFavoriteRevisionsDescription": "Each edit to a favorite's SQL keeps a revision; the current one is always kept.",
  "SqlMemoryStorageLimitItemMb256": "256 MB",
  "SqlMemoryStorageLimitItemMb512": "512 MB",
  "SqlMemoryStorageLimitItemGb1": "1 GB",
  "SqlMemoryStorageLimitItemUnlimited": "Unlimited",
  "SqlMemoryStorageLimitTitle": "Storage: size limit",
  "SqlMemoryStorageLimitDescription": "Once exceeded, background cleanup shortens the retention settings above step by step until usage is back under the limit. This isn't a hard disk quota: favorites, pinned items, and open query windows are never deleted to free space.",
  "SqlMemoryMaintenanceMinutesTitle": "Storage: background maintenance interval",
  "SqlMemoryMaintenanceMinutesDescription": "How often background cleanup runs. It may run earlier while SSMS is idle, and handles a limited number of items at a time so editing isn't blocked.",
  "NotificationsEnabledTitle": "Show notifications",
  "NotificationsEnabledDescription": "Shows running and recently finished work, plus prompts that need your decision, in the lower-right corner of the window that holds the active query window.",
  "NotificationsGlassTitle": "Glass material",
  "NotificationsGlassDescription": "Uses layered edges in theme colors. High contrast mode always uses an opaque material.",
  "NotificationsDelayTitle": "Display delay (ms)",
  "NotificationsDelayDescription": "Delays showing notifications; by default they appear immediately.",
  "NotificationsRetentionTitle": "Time to keep finished work (ms)",
  "NotificationsRetentionDescription": "When a finished item expires, it's removed from both the finished count and the total. Failures and partial successes stay for at least six seconds.",
  "NotificationsVerbosityItemQuiet": "Quiet: only what's worth knowing",
  "NotificationsVerbosityItemNormal": "Normal: show each task",
  "NotificationsVerbosityItemVerbose": "Verbose: also show step-by-step detail work",
  "NotificationsVerbosityItemAll": "All: also show tracing work that only feeds diagnostic statistics",
  "NotificationsVerbosityTitle": "Verbosity",
  "NotificationsVerbosityDescription": "Sets which level of work appears on screen. Actions you just triggered, failures, and partial successes ignore this threshold; \"All\" also shows the tracing work done while you type.",
  "NotificationsMetadataTitle": "Metadata loading",
  "NotificationsMetadataDescription": "Object, column, collation, and cache queries that happen automatically; cache hits aren't included.",
  "NotificationsCompletionTitle": "Suggestion list",
  "NotificationsCompletionDescription": "Preparing and sorting the suggestion list and parameter info while you type; frequent notifications are hidden by default.",
  "NotificationsAnalysisTitle": "Syntax and block analysis",
  "NotificationsAnalysisDescription": "T-SQL analysis that runs repeatedly while you type; hidden by default to reduce distraction.",
  "NotificationsPreviewTitle": "Quick Info and structure preview",
  "NotificationsPreviewDescription": "Loading done by Quick Info and the floating structure preview.",
  "NotificationsPackageTitle": "Initialization and connections",
  "NotificationsPackageDescription": "SqlAssist startup work, and creating and rechecking metadata connections.",
  "NotificationsEditingTitle": "Editing and expansion",
  "NotificationsEditingDescription": "Work that writes back to the editor, such as expanding SELECT * with Tab, expanding statement templates, and auto-pairing.",
  "NotificationsNavigationTitle": "Go to Definition",
  "NotificationsNavigationDescription": "F12 generating a definition and opening it in a new query window.",
  "NotificationsResultsTitle": "Results grid",
  "NotificationsResultsDescription": "Generating scripts from query results, copying full values, and column profiles.",
  "NotificationsSnippetsTitle": "Code snippets",
  "NotificationsSnippetsDescription": "Loading, saving, and restoring built-in and custom snippets.",
  "NotificationsSettingsTitle": "Settings",
  "NotificationsSettingsDescription": "Rereading settings and reporting how they were applied to the editor.",
  "NotificationsSqlMemoryTitle": "SQL Memory",
  "NotificationsSqlMemoryDescription": "Enabling, cleaning up, clearing, and backing up SQL Memory, plus events such as skipped captures and size warnings.",
  "NotificationsSearchTitle": "SQL Search",
  "NotificationsSearchDescription": "SQL Search copying, applying a query window's connection, search failures, and preview matches that can't be highlighted. Go to Definition and Select in Object Explorer are under \"Go to Definition\".",
  "NotificationsUnclassifiedTitle": "Unclassified",
  "NotificationsUnclassifiedDescription": "Work that hasn't been categorized yet. Shown by default; turning it off may silently hide whole groups of newly added work.",
  "NotificationsFailuresTitle": "Show all kinds of failures",
  "NotificationsFailuresDescription": "Controls error notifications separately, so they show even when their kind is hidden. Doesn't affect the diagnostic log.",
  "NotificationsDegradedTitle": "Show partial successes",
  "NotificationsDegradedDescription": "Work that got its main result but couldn't retrieve some data. When off, it's reported as a plain success.",
  "DiagnosticsVerboseLoggingTitle": "Write detailed diagnostic logs",
  "DiagnosticsVerboseLoggingDescription": "Writes per-suggestion and commit details to %LOCALAPPDATA%\\SqlAssist.Ssms22\\SqlAssist.log. Turn on only when reporting an issue.",
  "CategoryNotificationsTitle": "Notifications and background tasks",
  "CategoryNotificationsDescription": "The notification island in the lower-right corner shows what SqlAssist is doing, has just finished, and needs you to decide.",
  "CategorySqlAssistTitle": "SqlAssist",
  "CategorySqlAssistDescription": "Real-time T-SQL suggestions, code snippets, and database object structure preview.",
  "CategoryGeneralTitle": "General",
  "CategoryGeneralDescription": "The master switch, rewrites while typing, update checks, and UI animations for all of SqlAssist. Turning off \"Enable SqlAssist\" turns off everything on the pages below.",
  "CategorySuggestionsTitle": "Suggestion list",
  "CategorySuggestionsDescription": "When the list appears and what it contains. What the inserted text looks like is on the \"Insertion and expansion\" page.",
  "CategorySuggestionsMessage": "Keep SSMS's T-SQL IntelliSense on—red error squiggles and outlining depend on it. \"Use only the SqlAssist suggestion list\" already blocks the part that conflicts. For the current status, see \"Tools > SqlAssist > About and Diagnostics...\".",
  "CategoryInsertionTitle": "Insertion and expansion",
  "CategoryInsertionDescription": "Decides what text ends up in the editor: how object names are written, SELECT * expansion, and five kinds of statement expansion. The master switch is on the \"General\" page; statement expansion also needs the list turned on on the \"Suggestion list\" page.",
  "CategoryStructureTitle": "Object structure",
  "CategoryStructureDescription": "Quick Info and the floating structure preview next to the suggestion list; each works independently. The master switch is on the \"General\" page.",
  "CategoryBlocksTitle": "Block matching",
  "CategoryBlocksDescription": "Highlights T-SQL start and end keywords and brackets.",
  "CategorySqlMemoryTitle": "SQL Memory",
  "CategorySqlMemoryDescription": "Keeps SQL from your query windows in a database on this computer for later lookup, recovery, and favorites. A notification appears the first time capture starts. The master switch is on the \"General\" page.",
  "CategorySqlMemoryCommand": "Open SQL Memory usage...",
  "CategoryDiagnosticsTitle": "Diagnostics",
  "CategoryDiagnosticsCommand": "Open diagnostic log"
}

<?xml version="1.0" encoding="utf-8"?>
<!--
  英文 SSMS 在擴充功能管理員與安裝程式上顯示的名稱與說明；其他介面語言看 vsixmanifest 本身（繁中）。
  資料夾名稱就是比對的文化名稱，SSMS 只認 <文化>\Extension.vsixlangpack 這個位置。
  跟 SqlAssist 的語言設定無關：這裡由 SSMS 的介面語言決定。
-->
<VsixLanguagePack Version="1.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema-lp/2010">
  <LocalizedName>SqlAssist for SSMS 22</LocalizedName>
  <LocalizedDescription xml:space="preserve">T-SQL live suggestions, code snippets, and database object structure previews for SSMS 22. Settings are integrated into SSMS Unified Settings.</LocalizedDescription>
</VsixLanguagePack>

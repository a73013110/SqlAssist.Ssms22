  "SelectedCount": "已選 {count:N0} 筆",
  "SelectedAllCount": "已選全部 {count:N0} 筆",
  "SelectedAllMatching": "已選全部符合的項目",
  "SelectionLoadedNote": "已載入 {count:N0} 筆，其餘在執行動作時讀取",

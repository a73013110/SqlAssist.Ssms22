  "SortByToolTip": "{name}排序：{sort}",
  "SelectAll": "全選",
  "SelectAllOf": "全選{name}",
  "ClearAll": "全不選",
  "ClearAllOf": "全不選{name}",
  // ── 多選工具列 ──
  "SelectionToolbar": "多選工具列",

  "ReturnToBlockStart": "點擊返回區塊起始行",
  // 清單列右緣收起來的那些操作。
  "MoreActions": "更多操作",
  "ListFooter": "清單頁尾",
  // {name} 是那一列的名稱。
  "SelectRow": "選取 {name}",
  "RowCheckToolTip": "勾選或取消；Shift+點擊勾選一段",
  // 動作按鈕的提示；{shortcut} 是快捷鍵，例如 Ctrl+C。
  "ActionWithShortcut": "{action}（{shortcut}）",
  "TabHitCount": "{label}，{count} 個符合",
  "TabItemCount": "{label}，{count} 項",
  "TextSummary": "{lines:N0} 行 · {characters:N0} 字元",
  "UnreadableTitle": "這一輪讀不到",
  "DeniedTitle": "權限不足",
  // ── 複製 ──
  "CopySelection": "複製選取",
  "CopyAll": "複製全文",
  "CopySqlFailed": "複製 SQL 失敗：{message}",
  "ClipboardBusy": "剪貼簿正被其他程式使用，未複製；請稍後再試。",
  "NothingToCopy": "沒有可複製的項目。",
  // 通知標題已經是「已複製清單」，這一句是說明。
  "CopiedRows": "{rows:N0} 筆（含標頭列，可直接貼到 Excel）。",
  // ── 套用查詢視窗的連線 ──
  "ApplyEditorConnection": "套用查詢視窗的連線",
  "ApplyEditorConnectionToolTip": "套用查詢視窗的連線：{server} · {database}。只改範圍，不切換 SSMS 的連線。",
  "ApplyEditorConnectionUnavailable": "套用查詢視窗的連線：查詢視窗目前沒有連線。",
  "EditorNotConnected": "查詢視窗目前沒有連線；範圍保持不變。先在查詢視窗連上資料庫再按一次。",
  // ── 過濾面板；{name} 是過濾的對象，例如「伺服器」「資料庫」 ──
  "ClearFilterText": "清除{name}篩選字",
  "FilterByName": "篩選{name}名稱",
  "SortBy": "{name}排序",

  "WholeWord": "整個字",
  "WholeWordToolTip": "只找完整的字：搜 Copy 就不會找到 CopyNo 裡的那一段。",
  // 比對位置分段按鈕；「名稱」「欄位」用共用詞。
  "Targets": "比對位置",
  "TargetSegmentName": "比對位置：{target}",
  "TargetToolTip": "{target}：{description}",
  "TargetText": "內容",

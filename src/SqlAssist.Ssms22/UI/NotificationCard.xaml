<Border x:Class="SqlAssist.Ssms22.UI.NotificationCard" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SqlAssist.Ssms22.UI"
        Width="250" Padding="0" CornerRadius="9" BorderThickness="1" Cursor="Arrow"
        Background="Transparent" BorderBrush="{DynamicResource {x:Static ui:ThemeResourceSet.NotificationRimKey}}"
        SnapsToDevicePixels="True" UseLayoutRounding="True" RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform>
        <TransformGroup>
            <ScaleTransform x:Name="SurfaceScale"/>
            <TranslateTransform x:Name="SurfaceSlide"/>
        </TransformGroup>
    </Border.RenderTransform>
    <!-- 高覆蓋率半透明底只透出些許背景；文字本身不降低透明度。 -->
    <Border x:Name="Body" CornerRadius="8" Background="{DynamicResource {x:Static ui:ThemeBrush.ListBackground}}">
        <Grid>
            <Border x:Name="Sheen" CornerRadius="8" IsHitTestVisible="False"
                    Background="{DynamicResource {x:Static ui:ThemeResourceSet.NotificationSheenKey}}"/>
            <Grid Margin="8,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid x:Name="Header" Height="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="StatusIcon" Width="12" Height="12" Stretch="None" StrokeThickness="1.4" HorizontalAlignment="Left" VerticalAlignment="Center"
                          Stroke="{DynamicResource {x:Static ui:ThemeBrush.AccentBorder}}"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="StatusRotation"/>
                                <ScaleTransform x:Name="StatusScale"/>
                                <TranslateTransform x:Name="StatusShake"/>
                            </TransformGroup>
                        </Path.RenderTransform>
                    </Path>
                    <ContentControl x:Name="SummaryHost" Grid.Column="1" VerticalAlignment="Center"/>
                    <ContentControl x:Name="ToggleHost" Grid.Column="2" VerticalAlignment="Center" Margin="4,0"/>
                    <ContentControl x:Name="CloseHost" Grid.Column="3" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="ContextLabel" Grid.Row="1" Margin="18,0,0,4" FontSize="11"
                           Foreground="{DynamicResource {x:Static ui:ThemeResourceSet.NotificationDimKey}}"
                           TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                <ProgressBar x:Name="Progress" Grid.Row="2" Height="2" Minimum="0" Maximum="1" Focusable="False"
                             Foreground="{DynamicResource {x:Static ui:ThemeResourceSet.NotificationSpinnerKey}}"
                             Background="{DynamicResource {x:Static ui:ThemeBrush.SegmentTrack}}">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid ClipToBounds="True">
                                <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="1"/>
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="1"/>
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
                <ScrollViewer x:Name="DetailScroll" Grid.Row="3" Margin="0,8,0,4" MaxHeight="140">
                    <StackPanel x:Name="DetailsPanel"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Border>

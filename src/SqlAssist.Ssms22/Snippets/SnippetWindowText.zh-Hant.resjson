  "RestoreSelectedButton": "還原此預設",
  "AddButton": "新增",
  "DuplicateButton": "複製",
  "RevealFileButton": "開啟檔案位置",
  "RestoreDefaultsButton": "還原預設",
  // 欄位標籤／欄位表標題。
  "PlaceholderLabel": "佔位符",
  "DefaultValueColumnHeader": "預設值",
  "ShortcutFieldLabel": "捷徑",
  "TitleFieldLabel": "標題",
  "CategoryFieldLabel": "分類",
  "ExpansionModeFieldLabel": "展開模式",
  "CodeFieldLabel": "程式碼",
  // 表單下方的說明文字（小字提示）。
  "ShortcutHint": "輸入捷徑即可顯示建議；捷徑限字母、數字與底線。",
  // $名稱$、$end$、$surround$ 是片段樣板語法本身，不是佔位符，原樣保留。
  "CodeHint": "以 $名稱$ 標示佔位符，展開時會換成下面設定的預設值；以 $end$ 標示展開後游標要停的位置。\n加入一個 $surround$ 即可從右鍵包住選取 SQL；其餘欄位要能以 Tab 切換，請選「依序按 Tab 跳轉」。",
  "FollowUpHint": "只適用於「只移動游標」模式；接續內容由展開後的 SQL 上下文決定。",
  // 新增片段時的預設標題。
  "NewSnippetTitle": "新片段",
  // 狀態列訊息（選取一筆不符規則的片段時顯示）。
  "InvalidBlocksSave": "{violation}修好之前整份存不回檔案。",
  // 停用／刪除確認對話框。
  "DisableActionLabel": "停用",
  "ConfirmDisableTitle": "停用片段",
  "ConfirmDeleteTitle": "刪除片段",
  "ConfirmDisableMessage": "停用片段「{caption}」？",
  "ConfirmDeleteMessage": "刪除片段「{caption}」？",

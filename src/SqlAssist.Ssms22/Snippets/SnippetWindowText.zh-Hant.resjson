  "InvalidFormatStatus": "{filePath} 的格式不正確：{message}",

  // === SqlSnippetSurroundAction：包夾流程，訊息顯示在 SSMS 狀態列 ===

  "SelectTextFirst": "請先選取要包住的文字。",
  "BoxSelectionNotSupported": "框選範圍無法包夾，請改用一般選取。",
